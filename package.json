{
  "name": "field",
  "version": "0.1.0",
  "description": "Git-native, agent-operable music production system",
  "type": "module",
  "bin": {
    "field": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "field": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:native": "cmake -S native/audiod -B native/audiod/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/audiod/build -j"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
