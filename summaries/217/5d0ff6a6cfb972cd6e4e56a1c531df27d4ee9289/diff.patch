+        cli: { version: '0.3.0', commit: 'aaaa111', branch: 'main' },
+        workerProtocol: 2,
+        daemons: [],
+        remote: { api: 'https://audiofield.io', source: 'default' },
+      },
+      process.cwd(),
+    );
+    expect(text.split('\n')[0]).toBe('field 0.3.0  (aaaa111 on main)');
