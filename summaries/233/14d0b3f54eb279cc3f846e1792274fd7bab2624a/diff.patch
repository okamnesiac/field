+          { at: [1, 2, 241], length: [0, 0, 120], note: 67, channel: 2 },
+          { at: 480, length: 0, note: 36, velocity: 127 },
+        ],
+        controls: [{ at: [1, 4], cc: 74, value: 64 }],
