+    const outcomes = await buildLabels(root, ['//songs/creek/gen:keys-a', '//songs/creek/gen:keys-b'], runner);
+    expect(runs).toEqual(['keys-a']);
+    expect(outcomes.find((o) => o.label === '//songs/creek/gen:keys-b')).toMatchObject({ cached: true });
