+      tempo: steady,
+      meter: fourFour,
+    });
+    expect(resolved.length).toBe(2 * 3840 * TICK);
+    expect(resolveNotes(part({}), 0, { tempo: steady, meter: fourFour }).length).toBe(0);
+  });
+
+  it('names the row whose position the placement\'s meter does not have', () => {
