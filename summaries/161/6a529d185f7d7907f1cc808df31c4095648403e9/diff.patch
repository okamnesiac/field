+        OVERLAPPED ov {};
+        ov.hEvent = CreateEventA (nullptr, TRUE, FALSE, nullptr);
+        bool ok = ReadFile (asHandle (connection->pipe), chunk, sizeof (chunk), nullptr, &ov) != 0
+                      || GetLastError() == ERROR_IO_PENDING;
+        if (ok)
