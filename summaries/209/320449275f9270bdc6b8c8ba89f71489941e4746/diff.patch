--- /dev/null
+++ b/src/keys/knobs.test.ts
@@ -0,0 +1,165 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { parseDocument } from 'yaml';
+import type { Knob } from '../schema/knobs.js';
+import {
+  controllerOf,
+  formatKnobValue,
+  knobFileFor,
+  knobFileName,
+  knobList,
+  knobsCopy,
+  knobValue,
+  knobValueWidth,
+  KnobsError,
+  loadKnobs,
+  MOD_KNOB,
+  parseKnobs,
+  resolveKnobsPath,
+  stepFrom,
+} from './knobs.js';
+
+const shelf = join(import.meta.dirname, '..', '..', 'examples', 'bloom', 'shared', 'instruments');
+const juno = loadKnobs(join(shelf, 'juno.knobs.yaml'));
+const knob = (name: string): Knob => juno.find((k) => k.name === name)!;
+
+// Every value a knob prints, at every controller value.
+function printed(k: Knob): string[] {
+  return Array.from({ length: 128 }, (_, cc) => formatKnobValue(k, knobValue(k, cc)));
+}
+
+describe('finding knob files', () => {
+  it('finds an instrument’s knob file beside its program', () => {
+    expect(knobFileFor('/p/shared/instruments/juno.scd')).toBe('/p/shared/instruments/juno.knobs.yaml');
+    expect(knobFileFor('/p/pad.v2.scd')).toBe('/p/pad.v2.knobs.yaml');
+  });
+
+  it('resolves --knobs by bare name on the shelf, and by path', () => {
+    expect(resolveKnobsPath('juno', '/p')).toBe(join('/p', 'shared', 'instruments', 'juno.knobs.yaml'));
+    expect(resolveKnobsPath('~/knobs/ju-06a.yaml', '/p', { home: '/home/j' })).toBe(resolve('/home/j', 'knobs', 'ju-06a.yaml'));
+    expect(resolveKnobsPath('ju-06a.yaml', undefined, { cwd: '/here' })).toBe(resolve('/here', 'ju-06a.yaml'));
+    expect(resolveKnobsPath('./k', undefined, { cwd: '/here' })).toBe(resolve('/here', 'k'));
+    expect(() => resolveKnobsPath('juno', undefined)).toThrow(/not inside a Field project/);
+  });
+
+  it('names a knob file’s knobs after the file', () => {
+    expect(knobFileName('/p/juno.knobs.yaml')).toBe('juno');
+    expect(knobFileName('/home/j/knobs/ju-06a.yaml')).toBe('ju-06a');
+  });
+});
+
+describe('reading knob files', () => {
+  let dir: string;
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'field-knobs-'));
+  });
+  afterEach(() => rmSync(dir, { recursive: true, force: true }));
+
+  it('names every problem with the file', () => {
+    const path = join(dir, 'bad.knobs.yaml');
+    writeFileSync(path, 'knobs:\n  - { name: a, cc: 1 }\n  - { name: b, cc: 20, min: 0, max: 0 }\n');
+    expect(() => loadKnobs(path)).toThrow(KnobsError);
+    try {
+      loadKnobs(path);
+    } catch (err) {
+      expect((err as KnobsError).problems).toEqual([
+        'knobs.0.cc: a: cc 1 is the modulation wheel, which is the knob mod',
+        'knobs.1.max: b: min and max are both 0, so the knob has nowhere to turn',
+      ]);
+    }
+    expect(() => loadKnobs(join(dir, 'missing.yaml'))).toThrow(/no such file/);
+    expect(() => parseKnobs('knobs: [', 'x.yaml')).toThrow(KnobsError);
+  });
+
+  it('writes a copy with every field spelled out, which reads back the same', () => {
+    const copy = knobsCopy(parseKnobs('knobs:\n  - { name: tone, cc: 20 }\n', 'k.yaml'));
+    expect(parseDocument(copy).toJS()).toEqual({ knobs: [{ name: 'tone', cc: 20, min: 0, max: 127, curve: 'lin', step: 0, default: 0 }] });
+    expect(parseKnobs(knobsCopy(juno), 'copy.yaml')).toEqual(juno);
+  });
+});
+
+describe('the knob list', () => {
+  it('puts mod first, then each source’s knobs, named after their source when there are several', () => {
+    expect(knobList([{ name: 'juno', knobs: juno }]).map((k) => k.label)).toEqual(['mod', 'cutoff', 'res', 'attack', 'release']);
+    expect(knobList([]).map((k) => k.label)).toEqual(['mod']);
+    const both = knobList([
+      { name: 'keys', knobs: juno.slice(0, 1) },
+      { name: 'bass', knobs: juno.slice(0, 1) },
+    ]);
+    expect(both.map((k) => k.label)).toEqual(['mod', 'keys.cutoff', 'bass.cutoff']);
+    expect(both[0]!.knob).toBe(MOD_KNOB);
+  });
+});
+
+describe('controller values', () => {
+  it('maps a controller value as ControlSpec.map does', () => {
+    // ControlSpec(50, 15000, \exp).map(62 / 127) in SuperCollider 3.14.1.
+    expect(knobValue(knob('cutoff'), 62)).toBeCloseTo(809.6052, 3);
+    expect(knobValue(knob('cutoff'), 0)).toBeCloseTo(50);
+    expect(knobValue(knob('cutoff'), 127)).toBeCloseTo(15000);
+    expect(knobValue(knob('res'), 127)).toBeCloseTo(0.95);
+    expect(knobValue({ ...MOD_KNOB, max: 10, step: 1 }, 64)).toBe(5);
+  });
+
+  it('starts a knob from its default, unmapped and rounded', () => {
+    // ControlSpec(50, 15000, \exp).unmap(2000) is 0.6467, so 82.
+    expect(controllerOf(knob('cutoff'), 2000)).toBe(82);
+    expect(controllerOf(knob('res'), 0.3)).toBe(40);
+    expect(controllerOf(MOD_KNOB, 0)).toBe(0);
+  });
+
+  it('steps one controller value, and stops at either end', () => {
+    expect(stepFrom(knob('cutoff'), 82, 1)).toBe(83);
+    expect(stepFrom(knob('cutoff'), 82, -1)).toBe(81);
+    expect(stepFrom(knob('cutoff'), 127, 1)).toBe(127);
+    expect(stepFrom(knob('cutoff'), 0, -1)).toBe(0);
+  });
+
+  it('steps a knob with a step to the next value that maps differently', () => {
+    const toggle: Knob = { name: 'chorus', cc: 20, min: 0, max: 1, curve: 'lin', step: 1, default: 0 };
+    expect(stepFrom(toggle, 0, 1)).toBe(64);
+    expect(stepFrom(toggle, 64, 1)).toBe(64);
+    expect(stepFrom(toggle, 64, -1)).toBe(63);
+    expect(knobValue(toggle, 63)).toBe(0);
+  });
+});
+
+describe('printing a value', () => {
+  it('prints an exp knob to three significant digits, with k and m', () => {
+    expect(formatKnobValue(knob('cutoff'), 2000)).toBe('2.00 kHz');
+    expect(formatKnobValue(knob('cutoff'), knobValue(knob('cutoff'), 62))).toBe('810 Hz');
+    expect(formatKnobValue(knob('cutoff'), 15000)).toBe('15.0 kHz');
+    expect(formatKnobValue(knob('cutoff'), 50)).toBe('50.0 Hz');
+    expect(formatKnobValue(knob('cutoff'), 999.9)).toBe('1.00 kHz');
+    expect(formatKnobValue(knob('attack'), 0.8)).toBe('800 ms');
+    expect(formatKnobValue(knob('attack'), 0.005)).toBe('5.00 ms');
+    expect(formatKnobValue(knob('attack'), 0.9999)).toBe('1.00 s');
+    expect(formatKnobValue(knob('release'), 1.5)).toBe('1.50 s');
+    expect(formatKnobValue({ ...knob('cutoff'), units: undefined }, 2000)).toBe('2.00k');
+  });
+
+  it('prints a lin knob with the places its far end needs, and whole knobs whole', () => {
+    expect(printed(knob('res'))[0]).toBe('0.000');
+    expect(printed(knob('res'))[127]).toBe('0.950');
+    expect(formatKnobValue(knob('res'), 0.3)).toBe('0.300');
+    expect(printed(MOD_KNOB).slice(0, 3)).toEqual(['0', '1', '2']);
+    expect(formatKnobValue({ name: 'p', cc: 20, min: -1, max: 1, curve: 'lin', step: 0, default: 0 }, -0.0001)).toBe('0.00');
+  });
+
+  it('prints a lin knob with a fractional step to at least the step’s places', () => {
+    const quarters: Knob = { name: 'p', cc: 20, min: 0, max: 100, curve: 'lin', step: 2.5, default: 0 };
+    expect(formatKnobValue(quarters, 2.5)).toBe('2.5');
+    expect(printed(quarters)[127]).toBe('100.0');
+    expect(formatKnobValue({ ...quarters, max: 1, step: 0.5 }, 0.5)).toBe('0.50');
+  });
+
+  it('gives each knob one width across its default and all its values', () => {
+    expect(knobValueWidth(MOD_KNOB)).toBe(3);
+    expect(knobValueWidth(knob('cutoff'))).toBe(8);
+    expect(knobValueWidth(knob('res'))).toBe(5);
+    expect(knobValueWidth(knob('attack'))).toBe(7);
+    expect(knobValueWidth(knob('release'))).toBe(7);
+  });
+});
diff --git a/src/keys/knobs.ts b/src/keys/knobs.ts
new file mode 100644
index 00000000..e36e8737
--- /dev/null
+++ b/src/keys/knobs.ts
@@ -0,0 +1,198 @@
+import { readFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { basename, join, resolve } from 'node:path';
+import { parseDocument, stringify } from 'yaml';
+import { knobFileSchema, type Knob } from '../schema/knobs.js';
+import { watchText } from './watch.js';
+
+// Knob files (instrument-knobs.md §2.2): finding them, reading and
+// watching them, and what a controller value means on each knob.
+
+const SUFFIX = '.knobs.yaml';
+export const CC_MAX = 127;
+
+// The modulation wheel, the knob every instrument has, which `field keys`
+// shows first (§2.1).
+export const MOD_KNOB: Knob = { name: 'mod', cc: 1, min: 0, max: CC_MAX, curve: 'lin', step: 1, default: 0 };
+
+// A knob as the line names it: after its source's name when knobs come
+// from more than one place, as in keys.cutoff (§2.5).
+export interface ShownKnob {
+  label: string;
+  knob: Knob;
+}
+
+// `mod`, then each source's knobs in its file's order.
+export function knobList(sources: { name: string; knobs: Knob[] }[]): ShownKnob[] {
+  const named = sources.length > 1;
+  return [
+    { label: MOD_KNOB.name, knob: MOD_KNOB },
+    ...sources.flatMap(({ name, knobs }) => knobs.map((knob) => ({ label: named ? `${name}.${knob.name}` : knob.name, knob }))),
+  ];
+}
+
+// An instrument's knob file sits beside its program: juno.knobs.yaml for
+// juno.scd.
+export function knobFileFor(program: string): string {
+  return `${program.endsWith('.scd') ? program.slice(0, -'.scd'.length) : program}${SUFFIX}`;
+}
+
+// A bare name is a knob file on the project's instruments shelf, and
+// anything with a / or ending in .yaml is a path, as a keymap resolves.
+export function resolveKnobsPath(
+  spec: string,
+  root: string | undefined,
+  options: { home?: string; cwd?: string } = {},
+): string {
+  if (spec.includes('/') || spec.endsWith('.yaml')) {
+    const expanded = spec.startsWith('~/') ? join(options.home ?? homedir(), spec.slice(2)) : spec;
+    return resolve(options.cwd ?? process.cwd(), expanded);
+  }
+  if (root === undefined) {
+    throw new Error(
+      `--knobs ${spec}: a bare name names a knob file in a project's shared/instruments/, ` +
+        'and this is not inside a Field project; give a path instead, such as ./knobs.yaml',
+    );
+  }
+  return join(root, 'shared', 'instruments', `${spec}${SUFFIX}`);
+}
+
+// What a knob file's knobs are called on the line when knobs come from
+// more than one place: ju-06a for ju-06a.knobs.yaml or ju-06a.yaml.
+export function knobFileName(path: string): string {
+  const name = basename(path);
+  return name.endsWith(SUFFIX) ? name.slice(0, -SUFFIX.length) : basename(name, '.yaml');
+}
+
+export class KnobsError extends Error {
+  constructor(
+    readonly path: string,
+    readonly problems: string[],
+  ) {
+    super(`${path}:\n${problems.map((p) => `  ${p}`).join('\n')}`);
+  }
+}
+
+export function parseKnobs(text: string, path: string): Knob[] {
+  const doc = parseDocument(text);
+  if (doc.errors.length > 0) throw new KnobsError(path, doc.errors.map((e) => e.message.split('\n')[0]!));
+  const parsed = knobFileSchema.safeParse(doc.toJS());
+  if (!parsed.success) {
+    throw new KnobsError(
+      path,
+      parsed.error.issues.map((issue) => (issue.path.length > 0 ? `${issue.path.join('.')}: ${issue.message}` : issue.message)),
+    );
+  }
+  return parsed.data.knobs;
+}
+
+export function loadKnobs(path: string): Knob[] {
+  let text: string;
+  try {
+    text = readFileSync(path, 'utf8');
+  } catch (err) {
+    throw new KnobsError(path, [(err as NodeJS.ErrnoException).code === 'ENOENT' ? 'no such file' : (err as Error).message]);
+  }
+  return parseKnobs(text, path);
+}
+
+export type KnobsReload = { knobs: Knob[] } | { error: KnobsError };
+
+export function watchKnobs(path: string, onReload: (result: KnobsReload) => void, settleMs = 50): () => void {
+  return watchText(
+    path,
+    (text) => {
+      try {
+        onReload({ knobs: parseKnobs(text, path) });
+      } catch (err) {
+        onReload({ error: err instanceof KnobsError ? err : new KnobsError(path, [(err as Error).message]) });
+      }
+    },
+    settleMs,
+  );
+}
+
+// The copy of a checked knob file that a SuperCollider voice reads
+// through FIELD_KNOBS (§2.4): every field spelled out, defaults filled,
+// so the voice never has to know the schema's defaults.
+export function knobsCopy(knobs: Knob[]): string {
+  return stringify({ knobs });
+}
+
+// A controller value from 0 to 127 as the knob's value: SuperCollider's
+// ControlSpec.map for the warp of the same name, so a voice that maps
+// with ControlSpec agrees with the line.
+export function knobValue(knob: Knob, cc: number): number {
+  const x = cc / CC_MAX;
+  const value = knob.curve === 'exp' ? knob.min * (knob.max / knob.min) ** x : knob.min + (knob.max - knob.min) * x;
+  return knob.step > 0 ? Math.round(value / knob.step) * knob.step : value;
+}
+
+// The controller value a knob's value sits at, rounded: where a knob
+// that has not been turned starts from.
+export function controllerOf(knob: Knob, value: number): number {
+  const x =
+    knob.curve === 'exp' ? Math.log(value / knob.min) / Math.log(knob.max / knob.min) : (value - knob.min) / (knob.max - knob.min);
+  return Math.min(CC_MAX, Math.max(0, Math.round(x * CC_MAX)));
+}
+
+// One step up or down from controller value `cc`: the next value, or on a
+// knob with a step, the next that maps to a different value, so a knob
+// with two positions moves in one press. Stays at `cc` at either end.
+export function stepFrom(knob: Knob, cc: number, direction: 1 | -1): number {
+  const position = (v: number): number => (knob.step > 0 ? Math.round(knobValue(knob, v) / knob.step) : v);
+  const from = position(cc);
+  for (let v = cc + direction; v >= 0 && v <= CC_MAX; v += direction) {
+    if (position(v) !== from) return v;
+  }
+  return cc;
+}
+
+// A knob's value as the line prints it (§2.5), without its padding.
+export function formatKnobValue(knob: Knob, value: number): string {
+  if (Number.isInteger(knob.step) && knob.step >= 1) return withUnits(String(Math.round(value)), knob.units);
+  if (knob.curve === 'lin') {
+    const farthest = Math.max(Math.abs(knob.min), Math.abs(knob.max));
+    const places = Math.max(0, 2 - Math.floor(Math.log10(farthest)), decimalPlaces(knob.step));
+    return withUnits(fixed(value, places), knob.units);
+  }
+  const shown = Math.abs(Number(significant(value)));
+  if (shown >= 1000) return withUnits(significant(value / 1000), knob.units, 'k');
+  if (knob.units === 's' && shown < 1) return withUnits(significant(value * 1000), knob.units, 'm');
+  return withUnits(significant(value), knob.units);
+}
+
+// The widest the knob's value prints, at its default or at any controller
+// value, so turning it never moves what follows it.
+export function knobValueWidth(knob: Knob): number {
+  let width = formatKnobValue(knob, knob.default).length;
+  for (let cc = 0; cc <= CC_MAX; cc++) width = Math.max(width, formatKnobValue(knob, knobValue(knob, cc)).length);
+  return width;
+}
+
+// A prefix with no units to carry it goes on the number itself: 2.00k.
+function withUnits(number: string, units: string | undefined, prefix = ''): string {
+  return units === undefined ? `${number}${prefix}` : `${number} ${prefix}${units}`;
+}
+
+// Three significant digits, counted on the rounded value, so 0.9999
+// prints 1.00 rather than 1.000.
+function significant(x: number): string {
+  if (x === 0) return fixed(0, 2);
+  const places = (y: number): number => Math.max(0, 2 - Math.floor(Math.log10(Math.abs(y))));
+  return fixed(x, places(Number(x.toFixed(places(x)))));
+}
+
+// The decimal places a step is written with, as 1 for 2.5, so every value
+// it rounds to prints distinctly.
+function decimalPlaces(step: number): number {
+  let places = 0;
+  while (places < 10 && Math.abs(step * 10 ** places - Math.round(step * 10 ** places)) > 1e-9) places++;
+  return places;
+}
+
+// toFixed, without the sign it leaves on a value that rounds to zero.
+function fixed(x: number, places: number): string {
+  const text = x.toFixed(places);
+  return Number(text) === 0 ? text.replace('-', '') : text;
+}
