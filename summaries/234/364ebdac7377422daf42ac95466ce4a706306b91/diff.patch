+    std::array<double, noteSlots> offAt {};
+    double handedUntil = 0.0;
+
+    std::atomic<juce::int64> sent { 0 };
+    std::atomic<juce::int64> late { 0 };
+    std::atomic<juce::int64> early { 0 };
+    std::atomic<juce::int64> dropped { 0 };
