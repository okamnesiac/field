+            console.warn(`skipping a MIDI output test: ${reason}`);
+            ctx.skip(reason);
+          }
+          if (process.platform === 'win32') {
+            const reason = `no virtual MIDI ports on Windows, and midi_out said ${message}`;
+            console.warn(`skipping a MIDI output test: ${reason}`);
+            ctx.skip(reason);
