+    writeFileSync(join(origin, 'hooks', 'update'), '#!/bin/sh\ntest "$1" != refs/tags/v0\n', { mode: 0o755 });
+    expect(() => tag(checkout, { githubRelease: false })).toThrow('hook declined');
+    expect(git(origin, 'tag', '--list')).toBe('');
+  });
