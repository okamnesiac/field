+      join(root, 'songs/fast/song.yaml'),
+      'name: fast\nrate: 44100\ntime:\n  tempo:\n    - at: 0\n      bpm: 120\n  meter:\n    - at: 0\n      numerator: 4\n      denominator: 4\n',
