+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { installerPath, upgrade } from './upgrade.js';
+
+// `field upgrade` is a doorway to install.sh and nothing else
+// (install.md §2.5): it has to find the right installer, hand it the
+// target, and give back its exit status. These run real bash against a
+// stand-in installer, because the handoff is the whole command.
+
+const packageRoot = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
+
+let scratch: string;
+beforeEach(() => {
+  scratch = mkdtempSync(join(tmpdir(), 'field-upgrade-'));
+});
+afterEach(() => {
+  rmSync(scratch, { recursive: true, force: true });
+});
+
+// An installer that records its arguments and exits with a known status.
+function standIn(dir: string, status: number): { installer: string; argsFile: string } {
+  const installer = join(dir, 'install.sh');
+  const argsFile = join(dir, 'args');
+  writeFileSync(installer, `printf '%s\\n' "$#:$*" > "$(dirname "$0")/args"\nexit ${status}\n`);
+  return { installer, argsFile };
+}
+
+describe('field upgrade', () => {
+  it('finds the install.sh beside the package it runs from', () => {
+    expect(installerPath()).toBe(join(packageRoot, 'install.sh'));
+    expect(existsSync(installerPath())).toBe(true);
+  });
+
+  it('refuses on Windows, naming the build steps instead', () => {
+    const { installer } = standIn(scratch, 0);
+    expect(() => upgrade('cli', { installer, platform: 'win32', err: () => {} })).toThrow(
+      'install.sh, which does not support Windows yet',
+    );
+  });
+
+  it('refuses when there is no installer, rather than guessing at another', () => {
+    const installer = join(scratch, 'install.sh');
+    expect(() => upgrade(undefined, { installer, platform: 'darwin', err: () => {} })).toThrow(
+      `cannot upgrade: ${installer} does not exist`,
+    );
+  });
+});
+
+// These hand a real bash the stand-in, which Windows does not reliably have.
+describe.skipIf(process.platform === 'win32')('field upgrade runs the installer', () => {
+  it('hands the installer its target and returns its exit status', () => {
+    const { installer, argsFile } = standIn(scratch, 3);
+    const lines: string[] = [];
+    expect(upgrade('status', { installer, err: (line) => lines.push(line) })).toBe(3);
+    expect(readFileSync(argsFile, 'utf8')).toBe('1:status\n');
+    expect(lines).toEqual([`+ ${installer} status`]);
+  });
+
+  it('passes no target when given none, so the installer picks its default', () => {
+    const { installer, argsFile } = standIn(scratch, 0);
+    expect(upgrade(undefined, { installer, err: () => {} })).toBe(0);
+    expect(readFileSync(argsFile, 'utf8')).toBe('0:\n');
+  });
+
+  it('runs the installer through bash, so a checkout without the execute bit still upgrades', () => {
+    // writeFileSync leaves the stand-in at 0644.
+    const { installer } = standIn(scratch, 0);
+    expect(upgrade('cli', { installer, err: () => {} })).toBe(0);
+  });
+
+  it('quotes a path that needs it in the line it prints', () => {
+    const dir = join(scratch, "a checkout's home");
+    mkdirSync(dir);
+    const { installer } = standIn(dir, 0);
+    const lines: string[] = [];
+    upgrade('all', { installer, err: (line) => lines.push(line) });
+    expect(lines).toEqual([`+ '${scratch}/a checkout'\\''s home/install.sh' all`]);
+  });
+});
diff --git a/src/commands/upgrade.ts b/src/commands/upgrade.ts
new file mode 100644
index 00000000..1bfbc58a
--- /dev/null
+++ b/src/commands/upgrade.ts
@@ -0,0 +1,59 @@
+import { spawnSync } from 'node:child_process';
+import { existsSync } from 'node:fs';
+import { constants } from 'node:os';
+import { fileURLToPath } from 'node:url';
+
+// `field upgrade [target]`: run the installer of the checkout this command
+// was built from, with the same target, output, and exit status
+// (install.md §2.5). Installing belongs to install.sh, which knows how to
+// build and link each piece, so nothing here decides what an upgrade is.
+// It finds the installer the way the daemon and the keymaps are found:
+// beside the package this file was loaded from, which for a linked
+// checkout is the checkout itself.
+
+// Two levels up from src/commands/ and from dist/commands/ alike.
+export function installerPath(): string {
+  return fileURLToPath(new URL('../../install.sh', import.meta.url));
+}
+
+export interface UpgradeDeps {
+  installer?: string | undefined;
+  run?: ((script: string, args: string[]) => number) | undefined;
+  err?: ((line: string) => void) | undefined;
+  platform?: NodeJS.Platform | undefined;
+}
+
+export function upgrade(target: string | undefined, deps: UpgradeDeps = {}): number {
+  // install.sh is bash and builds with the POSIX toolchain, so on Windows
+  // this would hand a script to whatever `bash` resolves to, which may be
+  // WSL's and not the Windows side at all (install.md §7.6).
+  if ((deps.platform ?? process.platform) === 'win32') {
+    throw new Error(
+      'field upgrade runs install.sh, which does not support Windows yet — in the field checkout, run ' +
+        'pnpm install --frozen-lockfile, pnpm build, and pnpm build:native',
+    );
+  }
+  const installer = deps.installer ?? installerPath();
+  if (!existsSync(installer)) {
+    throw new Error(`cannot upgrade: ${installer} does not exist, so this field was not installed from a checkout`);
+  }
+  const args = target === undefined ? [] : [target];
+  const err = deps.err ?? ((line: string) => process.stderr.write(`${line}\n`));
+  // The command it runs, as you would type it, so the output that follows
+  // has a name and the step can be repeated by hand.
+  err(`+ ${[installer, ...args].map(displayQuote).join(' ')}`);
+  return (deps.run ?? runInstaller)(installer, args);
+}
+
+// Through bash rather than the script's own execute bit, which a checkout
+// with core.fileMode off, or one copied without modes, does not keep.
+function runInstaller(script: string, args: string[]): number {
+  const result = spawnSync('bash', [script, ...args], { stdio: 'inherit' });
+  if (result.error) throw result.error;
+  if (result.signal !== null) return 128 + (constants.signals[result.signal] ?? 0);
+  return result.status ?? 1;
+}
+
+function displayQuote(arg: string): string {
+  return /^[\w@%+=:,./-]+$/.test(arg) ? arg : `'${arg.replace(/'/g, `'\\''`)}'`;
+}
