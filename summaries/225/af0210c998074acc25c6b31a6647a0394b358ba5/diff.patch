+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { builtinKeymapDir, loadKeymap, parseKeymap } from './keymap.js';
+import { keyboardLines } from './keyboard.js';
+
+const musical = loadKeymap(join(builtinKeymapDir(), 'musical.yaml'));
+const REVERSE = '\x1b[7m';
+const REVERSE_OFF = '\x1b[27m';
+
+describe('the keyboard drawing', () => {
+  it('draws musical as keycaps: the home row, and the row above it half a key to the left, with gaps where no note plays', () => {
+    expect(keyboardLines(musical, new Set(), 80)).toEqual([
+      '  ┌───┬───┐   ┌───┬───┬───┐   ┌───┬───┐   ┌───┐',
+      '  │ W │ E │   │ T │ Y │ U │   │ O │ P │   │ ] │',
+      '┌─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┴─┬─┘',
+      "│ A │ S │ D │ F │ G │ H │ J │ K │ L │ ; │ ' │",
+      '└───┴───┴───┴───┴───┴───┴───┴───┴───┴───┴───┘',
+    ]);
+  });
+
+  it('lights each held key in reverse video, on both rows, and nothing else', () => {
+    const lines = keyboardLines(musical, new Set(['KeyA', 'KeyW', 'BracketRight', 'KeyZ']), 80)!;
+    expect(lines[1]).toBe(`  │${REVERSE} W ${REVERSE_OFF}│ E │   │ T │ Y │ U │   │ O │ P │   │${REVERSE} ] ${REVERSE_OFF}│`);
+    expect(lines[3]).toBe(`│${REVERSE} A ${REVERSE_OFF}│ S │ D │ F │ G │ H │ J │ K │ L │ ; │ ' │`);
+    expect([lines[0], lines[2], lines[4]].join('')).not.toContain(REVERSE);
+  });
+
+  it('draws nothing for a keymap with a note off those two rows, or on a terminal too narrow for it', () => {
+    expect(keyboardLines(loadKeymap(join(builtinKeymapDir(), 'tracker.yaml')), new Set(), 200)).toBeUndefined();
+    expect(keyboardLines(loadKeymap(join(builtinKeymapDir(), 'fourths.yaml')), new Set(), 200)).toBeUndefined();
+    expect(keyboardLines(musical, new Set(), 46)).toBeUndefined();
+    expect(keyboardLines(musical, new Set(), 47)).toHaveLength(5);
+  });
+
+  it('draws the keys a keymap of your own plays on those rows', () => {
+    const three = parseKeymap('name: three\nnotes: { KeyA: 0, KeyW: 1, KeyS: 2 }\n', 'three.yaml');
+    expect(keyboardLines(three, new Set(), 80)).toEqual(['  ┌───┐', '  │ W │', '┌─┴─┬─┴─┐', '│ A │ S │', '└───┴───┘']);
+  });
+});
diff --git a/src/keys/keyboard.ts b/src/keys/keyboard.ts
new file mode 100644
index 0000000..74c2433
--- /dev/null
+++ b/src/keys/keyboard.ts
@@ -0,0 +1,91 @@
+import { NAMED_ROWS, type Keymap, type RowName } from '../schema/keymap.js';
+import { US_LABELS } from './position.js';
+
+// The keyboard `field keys` draws above the knob line (keys.md, "Play"):
+// the keys that play notes, as keycaps with their US labels, the key held
+// down in reverse video. The row above the home row sits half a key to the
+// left, so each of its keys sits between two home-row keys, as a piano's
+// black keys do, and a key that plays nothing leaves a gap. It draws a
+// keymap whose notes are all on those two rows, which `musical`'s are.
+
+const KEY_WIDTH = 4;
+const ROWS: readonly { name: RowName; offset: number }[] = [
+  { name: 'top', offset: -KEY_WIDTH / 2 },
+  { name: 'home', offset: 0 },
+];
+
+const REVERSE = '\x1b[7m';
+const REVERSE_OFF = '\x1b[27m';
+
+const UP = 1;
+const DOWN = 2;
+const LEFT = 4;
+const RIGHT = 8;
+const JUNCTIONS: Record<number, string> = {
+  [LEFT]: '─',
+  [RIGHT]: '─',
+  [LEFT | RIGHT]: '─',
+  [UP]: '│',
+  [DOWN]: '│',
+  [UP | DOWN]: '│',
+  [DOWN | RIGHT]: '┌',
+  [DOWN | LEFT]: '┐',
+  [UP | RIGHT]: '└',
+  [UP | LEFT]: '┘',
+  [LEFT | RIGHT | DOWN]: '┬',
+  [LEFT | RIGHT | UP]: '┴',
+  [UP | DOWN | RIGHT]: '├',
+  [UP | DOWN | LEFT]: '┤',
+  [UP | DOWN | LEFT | RIGHT]: '┼',
+};
+
+interface Cap {
+  position: string;
+  x: number; // the column of its left wall
+  y: number; // the line of its top wall
+}
+
+// The drawing's lines, or undefined when the keymap plays a note off these
+// two rows or the drawing is wider than `width`.
+export function keyboardLines(keymap: Keymap, held: ReadonlySet<string>, width: number): string[] | undefined {
+  const rows = new Set<string>(ROWS.flatMap(({ name }) => NAMED_ROWS[name]));
+  if ([...keymap.notes.keys()].some((position) => !rows.has(position))) return undefined;
+
+  const caps: Cap[] = ROWS.flatMap(({ name, offset }, row) =>
+    NAMED_ROWS[name].flatMap((position, column) =>
+      keymap.notes.has(position) ? [{ position, x: offset + column * KEY_WIDTH, y: row * 2 }] : [],
+    ),
+  );
+  if (caps.length === 0) return undefined;
+  const left = Math.min(...caps.map((cap) => cap.x));
+  for (const cap of caps) cap.x -= left;
+  const columns = Math.max(...caps.map((cap) => cap.x)) + KEY_WIDTH + 1;
+  if (columns > width) return undefined;
+
+  const lines = ROWS.length * 2 + 1;
+  const edges = Array.from({ length: lines }, () => new Array<number>(columns).fill(0));
+  const across = (y: number, x0: number, x1: number): void => {
+    for (let x = x0; x <= x1; x++) edges[y]![x]! |= (x > x0 ? LEFT : 0) | (x < x1 ? RIGHT : 0);
+  };
+  const down = (x: number, y0: number, y1: number): void => {
+    for (let y = y0; y <= y1; y++) edges[y]![x]! |= (y > y0 ? UP : 0) | (y < y1 ? DOWN : 0);
+  };
+  for (const { x, y } of caps) {
+    across(y, x, x + KEY_WIDTH);
+    across(y + 2, x, x + KEY_WIDTH);
+    down(x, y, y + 2);
+    down(x + KEY_WIDTH, y, y + 2);
+  }
+
+  const text = edges.map((line) => line.map((bits) => JUNCTIONS[bits] ?? ' '));
+  for (const { position, x, y } of caps) text[y + 1]![x + 2] = US_LABELS.get(position) ?? '?';
+  // A held key's face, the three columns between its walls, in reverse
+  // video.
+  return text.map((line, y) => {
+    const faces = new Set(caps.filter((cap) => cap.y + 1 === y && held.has(cap.position)).map((cap) => cap.x + 1));
+    return line
+      .map((character, x) => `${faces.has(x) ? REVERSE : ''}${character}${faces.has(x - (KEY_WIDTH - 2)) ? REVERSE_OFF : ''}`)
+      .join('')
+      .trimEnd();
+  });
+}
