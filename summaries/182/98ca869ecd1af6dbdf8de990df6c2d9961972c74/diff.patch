new file mode 100644
index 0000000..c773e1b
--- /dev/null
+++ b/sc/voice-render.scd
@@ -0,0 +1,71 @@
+// Renders a recorded take offline through an instrument's voice
+// (keyboard-instrument.md §12), with the voicer the live voice host uses,
+// so the take sounds as it was heard while it was played. Runs under the
+// sc-render contract, plus the take:
+//
+// FIELD_INSTRUMENT  the instrument program, loaded under FIELD_MODE=voice
+// FIELD_EVENTS      a JSON file: {"events": [[seconds, kind, ...], ...]},
+//                   in time order, where kind is "on" (channel, note,
+//                   velocity), "off" (channel, note), "cc" (channel,
+//                   number, value), or "bend" (channel, value)
+// FIELD_OUTPUT, FIELD_SAMPLE_RATE, FIELD_CHANNELS, FIELD_DURATION
+(
+var instrument = "FIELD_INSTRUMENT".getenv;
+var eventsPath = "FIELD_EVENTS".getenv;
+var out = "FIELD_OUTPUT".getenv;
+var rate = "FIELD_SAMPLE_RATE".getenv.asInteger;
+var chans = "FIELD_CHANNELS".getenv.asInteger;
+var dur = "FIELD_DURATION".getenv.asFloat;
+var voiceDef, loadError, take, score, voicer, now = 0.0, nextNode = 1000;
+
+// Read above, and gone before the instrument loads: in voice mode the
+// render variables are absent, here as live (keys.md).
+["FIELD_OUTPUT", "FIELD_SEED", "FIELD_DURATION", "FIELD_SAMPLE_RATE", "FIELD_CHANNELS"].do(_.unsetenv);
+
+voiceDef = try { thisProcess.interpreter.executeFile(instrument) } { |error| loadError = error.errorString; nil };
+case
+{ loadError.notNil } {
+	("ERROR: " ++ PathName(instrument).fileName ++ " does not answer FIELD_MODE=voice: " ++ loadError).postln;
+	1.exit;
+}
+{ voiceDef.isKindOf(SynthDef).not } {
+	("ERROR: " ++ PathName(instrument).fileName ++ " does not answer FIELD_MODE=voice: in voice mode its value must be a SynthDef").postln;
+	1.exit;
+}
+{
+	take = File.readAllString(eventsPath).parseJSON;
+	score = Score.new;
+	score.add([0.0, ['/d_recv', voiceDef.asBytes]]);
+
+	voicer = thisProcess.interpreter.executeFile(PathName(thisProcess.nowExecutingPath).pathOnly +/+ "voicer.scd").(
+		{ |note, velocity, freq|
+			var node = nextNode;
+			nextNode = nextNode + 1;
+			score.add([now, [\s_new, voiceDef.name, node, 0, 0, \freq, freq, \amp, velocity / 127, \gate, 1, \out, 0]]);
+			node
+		},
+		{ |node, freq| score.add([now, [\n_set, node, \freq, freq]]) },
+		{ |node| score.add([now, [\n_set, node, \gate, 0]]) }
+	);
+
+	take["events"].do { |event|
+		now = event[0].asFloat;
+		switch (event[1].asString)
+		{ "on" } { voicer.noteOn(event[2].asInteger, event[3].asInteger, event[4].asInteger) }
+		{ "off" } { voicer.noteOff(event[2].asInteger, event[3].asInteger) }
+		{ "cc" } { voicer.cc(event[2].asInteger, event[3].asInteger, event[4].asInteger) }
+		{ "bend" } { voicer.bend(event[2].asInteger, event[3].asInteger) };
+	};
+
+	score.add([dur, [\c_set, 0, 0]]);
+	score.recordNRT(
+		outputFilePath: out,
+		sampleRate: rate,
+		headerFormat: "WAV",
+		sampleFormat: "int24",
+		options: ServerOptions.new.numOutputBusChannels_(chans),
+		duration: dur,
+		action: { 0.exit }
+	);
+};
+)
diff --git a/sc/voicer.scd b/sc/voicer.scd
new file mode 100644
index 0000000..a9c4544
--- /dev/null
+++ b/sc/voicer.scd
@@ -0,0 +1,63 @@
+// The rules between MIDI and voices, shared by the live voice host and the
+// offline render of a recorded take (keyboard-instrument.md §2.6, §12), so
+// a take renders with exactly the voicing it was played with: one voice
+// per sounding note, the sustain pedal (CC 64), All Notes Off (CC 123),
+// and pitch bend of up to two semitones on every sounding voice.
+//
+// Its value is a function of three callbacks and an optional fourth:
+//   start.(note, velocity, freq) -> a voice
+//   setFreq.(voice, freq)
+//   release.(voice)
+//   onVoice.(note, sounding), told as each voice starts and ends
+// and returns an Event that takes noteOn, noteOff, cc, bend, and
+// forgetVoices. No entry may share a name with a method Event already has,
+// such as clear (Set.clear): the method runs instead, and empties the Event.
+{ |start, setFreq, release, onVoice|
+	var voices = Dictionary.new, sustained = Set.new, sustainDown = false, bend = 0;
+	var releaseKey, freqOf;
+	freqOf = { |note| (note + bend).midicps };
+	releaseKey = { |key|
+		voices.removeAt(key) !? { |voice|
+			release.(voice);
+			onVoice !? { onVoice.(key % 128, false) };
+		};
+	};
+	(
+		noteOn: { |self, chan, note, velocity|
+			var key = chan * 128 + note;
+			if (velocity == 0) { self.noteOff(chan, note) } {
+				voices[key] !? { |old| release.(old) };
+				sustained.remove(key);
+				voices[key] = start.(note, velocity, freqOf.(note));
+				onVoice !? { onVoice.(note, true) };
+			};
+		},
+		noteOff: { |self, chan, note|
+			var key = chan * 128 + note;
+			if (sustainDown) { sustained.add(key) } { releaseKey.(key) };
+		},
+		cc: { |self, chan, number, value|
+			case
+			{ number == 64 } {
+				if (value >= 64) { sustainDown = true } {
+					sustainDown = false;
+					sustained.copy.do(releaseKey);
+					sustained.clear;
+				};
+			}
+			{ number == 123 } {
+				voices.keys.copy.do(releaseKey);
+				sustained.clear;
+			};
+		},
+		bend: { |self, chan, value|
+			bend = (value - 8192) / 8192 * 2;
+			voices.keysValuesDo { |key, voice| setFreq.(voice, freqOf.(key % 128)) };
+		},
+		forgetVoices: { |self|
+			voices.clear;
+			sustained.clear;
+			sustainDown = false;
+		}
+	)
+}
