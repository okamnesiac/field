+    const child = spawn(binary!, ['--keys', name], { stdio: 'pipe' });
+    const helper: Helper = {
+      child,
+      lines: [],
+      stderr: '',
+      ended: false,
+      closed: new Promise((resolve) => child.on('close', () => resolve())),
+    };
+    child.on('close', () => {
+      helper.ended = true;
+    });
+    child.on('error', (error) => {
+      helper.stderr += String(error);
+    });
+    child.stdin.on('error', () => {});
+    child.stderr.on('data', (chunk) => {
