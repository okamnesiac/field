index 00000000..1d4b4630
--- /dev/null
+++ b/src/commands/ui-edits.ts
@@ -0,0 +1,443 @@
+import { type Document, isNode, isSeq, parseDocument } from 'yaml';
+import { z } from 'zod';
+import { placedWindow } from '../generators/stem.js';
+import {
+  eqBandSchema,
+  eqParams,
+  hallParams,
+  limitParams,
+  plateParams,
+  reverbParams,
+  trackOrder,
+} from '../schema/index.js';
+import type { InputEntry } from '../schema/index.js';
+import type { MeterMap, TempoMap } from '../time/tempo.js';
+import { canonicalizeDocument, stringifyDocument } from '../yaml/emit.js';
+
+// The socket's file edits, as pure text → text functions. `field ui` is
+// the most write-capable thing in the CLI — five ops that change bytes
+// in files the author also edits by hand — and every defect this
+// surface has produced was the same shape: a write that was *almost*
+// what a person would have typed, invisible to a typecheck and to a
+// build. Pure functions over document text are the form a test can
+// hold to that standard: write, read back, compare bytes (#163
+// review). ui.ts keeps what genuinely needs the server — resolution,
+// stale-hash guards, the daemon — and calls down into here.
+
+export type EditOutcome =
+  | { ok: true; text: string }
+  | { ok: false; message: string; refresh?: boolean };
+
+// `at`, written the way the author spelled it. A musical array stays an
+// array — re-spelled through the owner's meter map, positionTicks's own
+// inverse — because an edit that flattens `at: [5]` to `at: 7680` is the
+// one write in this surface that does not read like something a person
+// typed. A scalar stays ticks, zero deletes the key (defaults stay
+// implicit, as in edit), and the line's comment is carried across the
+// node swap by hand: replacing a sequence with a fresh node discards the
+// comment attached to the old one, where scalar-over-scalar keeps it,
+// which is why edit never had this problem (#163 review).
+function setAt(doc: Document, meter: MeterMap, index: number, at: number, musical: boolean): void {
+  const oldNode = doc.getIn(['inputs', index, 'at'], true);
+  const comment = isNode(oldNode) ? oldNode.comment : undefined;
+  if (isSeq(oldNode) && musical) {
+    const [bar, beat, tick] = meter.position(at);
+    // The shortest array that means it, as a person would write it —
+    // through createNode, because setIn stores a raw JS array as-is:
+    // unwrapped, it dodges the canonicalizer's flow flag (isSeq is
+    // false on an Array) and stringifies block-style.
+    const spelled = tick > 1 ? [bar, beat, tick] : beat > 1 ? [bar, beat] : [bar];
+    doc.setIn(['inputs', index, 'at'], doc.createNode(spelled));
+  } else if (at === 0) {
+    doc.deleteIn(['inputs', index, 'at']);
+  } else {
+    doc.setIn(['inputs', index, 'at'], at);
+  }
+  if (comment != null) {
+    const fresh = doc.getIn(['inputs', index, 'at'], true);
+    if (isNode(fresh)) fresh.comment = comment;
+  }
+}
+
+// A duration keeps its spelling and its comment the same way, with one
+// wrinkle worth naming: `at` is an ordinal position while duration is a
+// cardinal span, and a span's musical spelling depends on where it
+// starts, since a meter change inside it changes what a bar is worth. So
+// a span is re-spelled through span() from its own anchor. The spelling
+// is read once and handed back as a writer, because a split writes both
+// halves out of the original entry's node. An open window has no
+// duration node to read, so the new key follows the entry's `at`, the
+// way setAt reads it: `at: [5]` gets `duration: [2]`, not 7680 beside it,
+// and an entry with no `at` at all claims no musical spelling, so it
+// gets ticks.
+function durationSpeller(doc: Document, meter: MeterMap, source: number, musical: boolean) {
+  const oldDur = doc.getIn(['inputs', source, 'duration'], true);
+  const comment = isNode(oldDur) ? oldDur.comment : undefined;
+  const spelledLike = oldDur === undefined ? doc.getIn(['inputs', source, 'at'], true) : oldDur;
+  const wasSeq = isSeq(spelledLike) && musical;
+  return (index: number, from: number, span: number): void => {
+    if (wasSeq) {
+      const [bars, beats, rest] = meter.span(from, span);
+      const spelled = rest > 0 ? [bars, beats, rest] : beats > 0 ? [bars, beats] : [bars];
+      doc.setIn(['inputs', index, 'duration'], doc.createNode(spelled));
+    } else {
+      doc.setIn(['inputs', index, 'duration'], span);
+    }
+    if (comment != null) {
+      const fresh = doc.getIn(['inputs', index, 'duration'], true);
+      if (isNode(fresh)) fresh.comment = comment;
+    }
+  };
+}
+
+// How far, in samples, a window's start moved when it advanced by `units`
+// of the entry's own unit. The read has to advance by exactly that, so
+// the content under the moved edge does not slide: for a musical entry
+// the edge lands on a whole tick, which can sit up to half a tick from
+// the sample the gesture named, so the distance is measured from the
+// tick it landed on. An absolute entry's units are already samples.
+function windowAdvance(parsed: InputEntry, units: number, start: number, tempo: TempoMap): number {
+  if (parsed.anchor === 'absolute') return units;
+  return Math.round(tempo.ticksToSamples(parsed.at + units)) - Math.round(start);
+}
+
+// One placement edit: set or clear gain_db / pan / mute on an input
+// entry. Defaults stay implicit: writing `mute: false` or `pan: 0` onto
+// an entry that never spelled them would churn the file.
+export function applyEdit(raw: string, entry: number, set: Record<string, unknown>): EditOutcome {
+  const doc = parseDocument(raw);
+  for (const [key, value] of Object.entries(set)) {
+    const isDefault = (key === 'mute' && value === false) || (key !== 'mute' && value === 0);
+    if (isDefault) doc.deleteIn(['inputs', entry, key]);
+    else doc.setIn(['inputs', entry, key], value);
+  }
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Move a placement by a delta in session samples. The delta is
+// anchor-agnostic — a sample is a sample whichever way `at` is spelled,
+// and the entry's own origin cancels out. The parsed entry and the
+// owner's maps come from the caller, which is the model layer's load:
+// arrays already rewritten to ticks, the shape placedWindow takes.
+export function applyMove(
+  raw: string,
+  entry: number,
+  parsed: InputEntry,
+  delta: number,
+  tempo: TempoMap,
+  meter: MeterMap,
+): EditOutcome {
+  const doc = parseDocument(raw);
+  const w = placedWindow(parsed, tempo);
+  const local = Math.max(0, w.start + delta);
+  const at = parsed.anchor === 'absolute' ? Math.round(local) : Math.round(tempo.samplesToTicks(local));
+  // What the author wrote stays theirs across the move: setAt spells
+  // the line the way the line was already spelled, and a clip dragged
+  // back to zero loses its `at:` rather than gaining `at: 0`.
+  setAt(doc, meter, entry, at, parsed.anchor !== 'absolute');
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Split one placement into two at an offset within its window, given
+// in session samples — origin-free the same way move's delta is. The
+// first half keeps the front (and its fade_in); the second starts at
+// the cut with `source_offset` advanced by the same distance, so the
+// source keeps reading where the first half stopped, and it keeps the
+// fade_out. Everything else — gain, pan, mute, slip, per-field comments
+// and spellings — is carried by cloning the entry node itself, which
+// is what makes the result read as two entries a person wrote rather
+// than one entry and a robot's paraphrase.
+//
+// The caller enforces what needs the model or the ledger: a positive
+// offset inside the window, no `loop:` (a loop tiles its window — the
+// two halves of a tiling are not two tilings), and a same-rate source,
+// because `source_offset` addresses the source's samples and a
+// cross-rate advance computed in session samples would land the second
+// half in the wrong place quietly.
+export function applySplit(
+  raw: string,
+  entry: number,
+  parsed: InputEntry,
+  offset: number,
+  tempo: TempoMap,
+  meter: MeterMap,
+): EditOutcome {
+  const doc = parseDocument(raw);
+  const node = doc.getIn(['inputs', entry], true);
+  if (!isNode(node) || !('clone' in node)) {
+    return { ok: false, message: `no input ${entry} — refreshed`, refresh: true };
+  }
+  const w = placedWindow(parsed, tempo);
+
+  // The cut in the entry's own unit: span ticks for a musical anchor,
+  // samples for an absolute one.
+  const musical = parsed.anchor !== 'absolute';
+  const cut = musical
+    ? Math.round(tempo.samplesToTicks(w.start + offset)) - parsed.at
+    : Math.round(offset);
+  if (cut <= 0) return { ok: false, message: 'the cut lands before the clip starts' };
+  if (parsed.duration !== undefined && cut >= parsed.duration) {
+    return { ok: false, message: 'the cut lands past the clip ends' };
+  }
+
+  // Two entries from one node: the clone carries every field, comment
+  // and spelling the original had, and each half then edits only what
+  // the cut changes.
+  const second = (node as { clone(): typeof node }).clone();
+  const inputs = doc.getIn(['inputs']) as { items: unknown[] };
+  inputs.items.splice(entry + 1, 0, second);
+
+  // Both halves keep the spelling and comment of the duration they were
+  // cut from, each re-spelled from its own anchor.
+  const setDuration = durationSpeller(doc, meter, entry, musical);
+
+  // First half: duration becomes the cut, the fade_out belongs to the
+  // second half now, and an id stays with the first — ids are unique.
+  setDuration(entry, parsed.at, cut);
+  doc.deleteIn(['inputs', entry, 'fade_out']);
+
+  // Second half: starts at the cut, spelled the way the author spelled
+  // `at` (the same rule as move, comment carried the same way), reads
+  // the source from where the first half stopped, keeps what remains
+  // of the duration, and drops what the first half kept.
+  setAt(doc, meter, entry + 1, parsed.at + cut, musical);
+  doc.setIn(['inputs', entry + 1, 'source_offset'], parsed.source_offset + windowAdvance(parsed, cut, w.start, tempo));
+  if (parsed.duration === undefined) {
+    // An open window stays open: the second half plays to the source's
+    // end, which is still "the whole of what remains" after the
+    // source_offset advance.
+    doc.deleteIn(['inputs', entry + 1, 'duration']);
+  } else {
+    setDuration(entry + 1, parsed.at + cut, parsed.duration - cut);
+  }
+  doc.deleteIn(['inputs', entry + 1, 'fade_in']);
+  doc.deleteIn(['inputs', entry + 1, 'id']);
+
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Stretch one edge of a placement's window: the drag that trims a clip
+// short or lets it play longer. `offset` is where the dragged edge
+// landed, in session samples measured from the clip's own window start —
+// origin-free the way move's delta and split's cut are, and one
+// definition that covers both edges. The start edge's number is how far
+// that edge travelled (negative reaches earlier); the end edge's is the
+// window's new length, which is the same measurement from the same
+// place.
+//
+// The end edge is a window edit and nothing else. `duration` moves, what
+// the source plays from does not, and a placement that never declared a
+// length gains the one the drag drew — trimming an open window is how a
+// person says "this much of it", and the alternative was refusing the
+// gesture on exactly the clips whose length nobody has pinned yet.
+//
+// The start edge moves the window and the read together: `at` later by
+// the drag, `duration` shorter by it, `source_offset` advanced by it, so
+// the content under the surviving part of the window does not slide.
+// That is split's second-half arithmetic, and it inherits split's
+// constraints — the caller refuses a cross-rate source, because
+// `source_offset` addresses the source's own samples, and a looped clip,
+// because a loop tiles from its window start and every repetition would
+// be re-cut. Neither constraint touches the end edge, which is why the
+// caller applies them per edge rather than to the op.
+export function applyStretch(
+  raw: string,
+  entry: number,
+  parsed: InputEntry,
+  edge: 'start' | 'end',
+  offset: number,
+  tempo: TempoMap,
+  meter: MeterMap,
+): EditOutcome {
+  const doc = parseDocument(raw);
+  if (doc.getIn(['inputs', entry], true) === undefined) {
+    return { ok: false, message: `no input ${entry} — refreshed`, refresh: true };
+  }
+  const musical = parsed.anchor !== 'absolute';
+  const w = placedWindow(parsed, tempo);
+  // Before the track's start the tempo map has no ticks to give, and
+  // samplesToTicks would throw; refuse it in words first.
+  if (edge === 'start' && w.start + offset < 0) {
+    return { ok: false, message: 'a clip cannot start before the track does' };
+  }
+  // The landing place in the entry's own unit: span ticks for a musical
+  // anchor, samples for an absolute one. Both edges convert the same
+  // way, since both are measured from the same window start.
+  const units = musical
+    ? Math.round(tempo.samplesToTicks(w.start + offset)) - parsed.at
+    : Math.round(offset);
+  const setDuration = durationSpeller(doc, meter, entry, musical);
+  // Fades live inside the window, and check refuses an entry whose fades
+  // outgrow it (model/project.ts). A trim that shrinks the window under
+  // its fades is refused like the arithmetic refusals here, not clamped:
+  // rewriting a fade the author set is its own surprise, and the message
+  // says what to shorten first.
+  const fadesOutgrow = (window: InputEntry): EditOutcome | undefined => {
+    const { duration } = placedWindow(window, tempo);
+    if (duration === undefined || parsed.fade_in + parsed.fade_out <= duration) return undefined;
+    return {
+      ok: false,
+      message:
+        `the fades (${parsed.fade_in} + ${parsed.fade_out} samples) would outgrow ` +
+        `the ${duration}-sample clip — shorten them first`,
+    };
+  };
+
+  if (edge === 'end') {
+    if (units < 1) return { ok: false, message: 'a clip cannot end where it starts' };
+    const refused = fadesOutgrow({ ...parsed, duration: units });
+    if (refused !== undefined) return refused;
+    setDuration(entry, parsed.at, units);
+    canonicalizeDocument(doc, trackOrder);
+    return { ok: true, text: stringifyDocument(doc) };
+  }
+
+  // A start edge that lands back where it began writes nothing: the
+  // author's bytes are already what the drag asked for.
+  if (units === 0) return { ok: true, text: raw };
+  const at = parsed.at + units;
+  if (at < 0) return { ok: false, message: 'a clip cannot start before the track does' };
+  // The read advances by the drag measured in session samples, which is
+  // the source's own distance only because the caller proved the rates
+  // agree. Backwards past the source's first sample has nothing to
+  // reveal, so it is refused rather than clamped — a clamp would leave
+  // the window and the content disagreeing about where the edge went.
+  const sourceOffset = parsed.source_offset + windowAdvance(parsed, units, w.start, tempo);
+  if (sourceOffset < 0) {
+    return { ok: false, message: 'the source has nothing before its first sample' };
+  }
+  if (parsed.duration !== undefined) {
+    const remaining = parsed.duration - units;
+    if (remaining < 1) return { ok: false, message: 'the clip would have no length left' };
+    const refused = fadesOutgrow({ ...parsed, at, duration: remaining });
+    if (refused !== undefined) return refused;
+    setDuration(entry, at, remaining);
+  }
+  // An open window stays open, exactly as it does across a split: the
+  // clip still plays what remains of the source from the advanced
+  // offset, which is what "the whole source" now means.
+  setAt(doc, meter, entry, at, musical);
+  if (sourceOffset === 0) doc.deleteIn(['inputs', entry, 'source_offset']);
+  else doc.setIn(['inputs', entry, 'source_offset'], sourceOffset);
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Insert parameter validation: the same zod objects the track schema is
+// built from, partial per effect, so this module can never produce a
+// value the engine would refuse.
+const effectParamSchemas = {
+  eq: z.strictObject(eqParams).partial(),
+  limit: z.strictObject(limitParams).partial(),
+  reverb: z.strictObject(reverbParams).partial(),
+  plate: z.strictObject(plateParams).partial(),
+  hall: z.strictObject(hallParams).partial(),
+};
+export type EffectName = keyof typeof effectParamSchemas;
+
+// Defaults, resolved once through the same schemas — never restated as
+// literals, because a rule kept in step by hand is a rule that drifts
+// (socketPath.ts says it; #163 review caught this module's band
+// defaults doing it). A value set back to its default is deleted
+// rather than written, and the asymmetry is why derivation matters: a
+// literal gone stale doesn't just churn, it drops a key whose meaning
+// then silently changes on the next load.
+const effectDefaults: Record<EffectName, Record<string, unknown>> = {
+  eq: z.strictObject(eqParams).omit({ bands: true }).parse({}),
+  limit: z.strictObject(limitParams).parse({}),
+  reverb: z.strictObject(reverbParams).parse({}),
+  plate: z.strictObject(plateParams).parse({}),
+  hall: z.strictObject(hallParams).parse({}),
+};
+const bandDefaults = eqBandSchema.omit({ type: true, frequency: true }).parse({});
+
+// Append an insert in its minimal spelling: parameters stay implicit at
+// their defaults, as a person would write it. The eq arrives as the
+// Fyra channel layout — the fixed homes a hand reaches for — flat, so
+// adding it changes nothing until a band moves.
+export function applyInsertAdd(raw: string, effect: EffectName): EditOutcome {
+  const doc = parseDocument(raw);
+  const fresh =
+    effect === 'eq'
+      ? {
+          effect: 'eq',
+          bands: [
+            { type: 'lowshelf', frequency: 90 },
+            { type: 'bell', frequency: 220 },
+            { type: 'bell', frequency: 500 },
+            { type: 'bell', frequency: 1200 },
+            { type: 'bell', frequency: 3200 },
+            { type: 'highshelf', frequency: 8000 },
+          ],
+        }
+      : { effect };
+  if (doc.getIn(['inserts']) === undefined) doc.setIn(['inserts'], doc.createNode([fresh]));
+  else doc.addIn(['inserts'], doc.createNode(fresh));
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Edit one insert's parameters. The effect is read from the document
+// itself; a hosted plugin's parameters belong to its own editor window
+// (plugin-hosting.md §5 chunk 3), not to this module.
+export function applyInsertEdit(raw: string, entry: number, set: Record<string, unknown>): EditOutcome {
+  const doc = parseDocument(raw);
+  if (doc.getIn(['inserts', entry]) === undefined) {
+    return { ok: false, message: `no insert ${entry} — refreshed`, refresh: true };
+  }
+  const effect = doc.getIn(['inserts', entry, 'effect']);
+  if (typeof effect !== 'string' || !(effect in effectParamSchemas)) {
+    return { ok: false, message: 'plugin inserts are read-only here' };
+  }
+  const parsed = effectParamSchemas[effect as EffectName].safeParse(set);
+  if (!parsed.success) {
+    return { ok: false, message: `bad ${effect} parameters` };
+  }
+  const defaults = effectDefaults[effect as EffectName];
+  // The keys the gesture sent, and only those: `.partial()` still fills
+  // every field's default, so parsed.data carries values for keys the
+  // client never touched, and writing those would reset what the file
+  // holds. The parse validates; `set` says what changes.
+  const validated = parsed.data as Record<string, unknown>;
+  for (const key of Object.keys(set)) {
+    const value = validated[key];
+    if (key === 'bands' && Array.isArray(value)) {
+      // Bands re-spelled minimally: per-band defaults stay implicit,
+      // so an untouched band keeps the two fields its author wrote.
+      const minimal = value.map((b) => {
+        const band: Record<string, unknown> = { type: b.type, frequency: b.frequency };
+        if (b.gain_db !== undefined && b.gain_db !== bandDefaults.gain_db) band['gain_db'] = b.gain_db;
+        if (b.bandwidth !== undefined && b.bandwidth !== bandDefaults.bandwidth) {
+          band['bandwidth'] = b.bandwidth;
+        }
+        return band;
+      });
+      doc.setIn(['inserts', entry, 'bands'], doc.createNode(minimal));
+    } else if (JSON.stringify(value) === JSON.stringify(defaults[key])) {
+      doc.deleteIn(['inserts', entry, key]);
+    } else {
+      doc.setIn(['inserts', entry, key], value);
+    }
+  }
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
+
+// Remove an insert. An emptied chain loses its key: `inserts: []` is
+// not something a person leaves behind.
+export function applyInsertRemove(raw: string, entry: number): EditOutcome {
+  const doc = parseDocument(raw);
+  if (doc.getIn(['inserts', entry]) === undefined) {
+    return { ok: false, message: `no insert ${entry} — refreshed`, refresh: true };
+  }
+  doc.deleteIn(['inserts', entry]);
+  const chain = doc.getIn(['inserts']);
+  if (chain !== undefined && typeof chain === 'object' && (chain as { items?: unknown[] }).items?.length === 0) {
+    doc.deleteIn(['inserts']);
+  }
+  canonicalizeDocument(doc, trackOrder);
+  return { ok: true, text: stringifyDocument(doc) };
+}
diff --git a/src/commands/ui-protocol.ts b/src/commands/ui-protocol.ts
new file mode 100644
index 00000000..3180dc82
--- /dev/null
+++ b/src/commands/ui-protocol.ts
@@ -0,0 +1,155 @@
+// The `field ui` wire format, in one place both ends compile against.
+//
+// This file exists because the client's copy of these shapes drifted
+// from the server's and blanked the window: the device list is
+// `{name, default}` objects, the client's hand-written interface said
+// `string[]`, and the first render threw on an object where React
+// expected a child. Nothing caught it — the interface was internally
+// consistent, so the client typechecked, and the server typechecked
+// against the daemon's real schemas, and the two were never compared.
+//
+// Deliberately types only, with no imports: `ui/` is a separate package
+// with a DOM tsconfig and no Node types, so anything importable by both
+// has to be free of both worlds. The server assigns daemon-schema values
+// into these shapes, which is where a daemon schema change now surfaces
+// as a compile error rather than as a blank page.
+
+export interface UiDevice {
+  name: string;
+  default: boolean;
+}
+
+export interface UiLane {
+  entry: number; // index into main's inputs — the edit locator
+  kind: 'track' | 'audio' | 'other';
+  name: string;
+  gain_db: number;
+  pan: number;
+  mute: boolean;
+  canSolo: boolean;
+  inserts: string[];
+  // A placed track that contains nothing. tall-grass ships two of
+  // them, and a silent lane that looks identical to a loud one reads
+  // as the UI being broken rather than the track being empty.
+  empty: boolean;
+}
+
+export interface UiStatus {
+  state: string;
+  sample: number;
+  samples: number;
+  musical: string;
+  device?: { name: string; sample_rate: number } | undefined;
+}
+
+// What the view needs to run its own clock. The daemon emits position
+// events on a 250 ms heartbeat, so a readout that only moves when one
+// arrives ticks four times a second and reads as broken — no amount of
+// machine speed fixes that, because the rate is the daemon's and the
+// samples in between simply are not sent. The view therefore projects
+// the playhead itself between events and resynchronises on each one.
+//
+// The maps travel as the plain event arrays the project already stores,
+// and the client builds the same `TempoMap`/`MeterMap` this process
+// uses — the class is pure arithmetic over these arrays, so both ends
+// run one implementation rather than two that can disagree. The daemon
+// still hears only samples (playback.md §3.6); what moved is which
+// client of the daemon spells bars, which ui.md §6 records.
+export interface UiClock {
+  sampleRate: number;
+  tempo: { at: number; bpm: number; ramp?: 'linear' | undefined }[];
+  meter: { at: number; numerator: number; denominator: number }[];
+}
+
+export interface UiSnapshot {
+  type: 'snapshot';
+  song: string;
+  lanes: UiLane[];
+  file: { path: string; sha256: string };
+  soloed: string | null;
+  devices: { devices: UiDevice[]; null_output: boolean };
+  status: UiStatus;
+  clock?: UiClock | undefined; // absent when the song has no tempo map
+  timeline?: UiTimeline | undefined;
+}
+
+export interface UiError {
+  type: 'error';
+  message: string;
+}
+
+export interface UiEvent {
+  type: 'event';
+  event: { event: string; state?: string; sample?: number; name?: string };
+  musical?: string;
+}
+
+// Server → client.
+export type UiDown = UiSnapshot | UiError | UiEvent;
+
+// One insert in a track's chain, parsed with defaults applied — the
+// client renders knobs from these values and sends whole-param edits
+// back against the track file's own hash. `effect` is the discriminant
+// for built-ins; a hosted plugin arrives as 'plugin' and is read-only
+// here (its knobs belong to its own editor window).
+export interface UiInsert {
+  entry: number;
+  effect: string;
+  params: Record<string, unknown>;
+}
+
+// The song in time. Absolute sample windows, projected server-side
+// through the planner's own arithmetic, plus one mark per bar — bars are
+// not linear in samples across a tempo ramp, so the ruler ships marks
+// rather than asking the view to interpolate.
+export interface UiMark {
+  sample: number;
+  bar: number;
+}
+
+export interface UiClip {
+  start: number;
+  duration: number;
+  // False when the placement declined to declare a length: the source's
+  // extent is not knowable while planning, and the block says so rather
+  // than drawing a guess as measurement.
+  exact: boolean;
+  name: string;
+}
+
+export interface UiTimelineLane {
+  entry: number; // index within `file` below — the edit locator
+  // Which file this lane's placement lives in. A top-level lane is a
+  // placement in main.yaml; a child lane is a placement in the placing
+  // track's own file, so an edit has to say which. The server validates
+  // this against the song's known track paths and never joins it.
+  file: string;
+  sha256: string; // per-file stale guard, since a lane may edit any of them
+  name: string;
+  start: number;
+  duration: number;
+  depth: number;
+  gain_db: number;
+  pan: number;
+  mute: boolean;
+  canSolo: boolean;
+  // The placed track's own file — where its inserts live — with its
+  // hash as the stale guard for insert ops. Null when the placement is
+  // not a track (raw audio, a generator), which is also the panel's
+  // signal that there is no chain to show.
+  trackFile: string | null;
+  trackSha256: string | null;
+  inserts: UiInsert[] | null;
+  // Null when this lane places audio rather than a track: there is
+  // nothing underneath, so no twirl is offered.
+  children: UiTimelineLane[] | null;
+  clips: UiClip[];
+  peaks?: number[] | undefined;
+}
+
+export interface UiTimeline {
+  rate: number;
+  length: number;
+  marks: UiMark[];
+  lanes: UiTimelineLane[];
+}
diff --git a/src/commands/ui-timeline.test.ts b/src/commands/ui-timeline.test.ts
new file mode 100644
index 00000000..1088c1d2
--- /dev/null
+++ b/src/commands/ui-timeline.test.ts
@@ -0,0 +1,90 @@
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { writeWavFloat32 } from '../audio/wav.js';
+import { loadProject } from '../model/project.js';
+import { createSong, createTrack } from './create.js';
+import { importAsset } from './import.js';
+import { init } from './init.js';
+import { projectTimeline } from './ui-timeline.js';
+
+// A lane's `entry` is what every socket op writes through, into the
+// document's `inputs:` list. Receives draw no lane, so the lane list is
+// shorter than `inputs:` whenever one is present, and the index has to be
+// the entry's place in the document, not its place among the lanes.
+
+describe('timeline lanes', () => {
+  let root: string;
+
+  beforeEach(async () => {
+    root = mkdtempSync(join(tmpdir(), 'field-ui-timeline-'));
+    init({ dir: root, name: 'album' });
+    createSong(root, 'creek');
+    for (const name of ['riff', 'pad']) {
+      const src = join(root, `${name}.wav`);
+      writeWavFloat32(src, 48000, [new Float32Array(4800)]);
+      await importAsset(root, 'creek', src, name);
+    }
+  });
+
+  afterEach(() => {
+    rmSync(root, { recursive: true, force: true });
+  });
+
+  function lanesOf(song = 'creek') {
+    const project = loadProject(root);
+    const loaded = project.songs.find((s) => s.name === song)!;
+    return projectTimeline(root, loaded, 48000, 96000, 8).lanes;
+  }
+
+  it('names a placement by its index in inputs:, past a receive ahead of it', () => {
+    writeFileSync(
+      join(root, 'songs/creek/tracks/main.yaml'),
+      ['name: main', 'inputs:', '  - receive: verb', '  - audio: riff', '  - audio: pad', ''].join('\n'),
+    );
+    expect(lanesOf().map((l) => [l.name, l.entry])).toEqual([
+      ['riff', 1],
+      ['pad', 2],
+    ]);
+  });
+
+  it("does the same for a placed track's children", () => {
+    createTrack(root, 'creek', 'keys');
+    writeFileSync(
+      join(root, 'songs/creek/tracks/keys.yaml'),
+      ['name: keys', 'inputs:', '  - receive: verb', '  - audio: pad', ''].join('\n'),
+    );
+    writeFileSync(join(root, 'songs/creek/tracks/main.yaml'), ['name: main', 'inputs:', '  - track: keys', ''].join('\n'));
+    const [keys] = lanesOf();
+    expect(keys?.children?.map((l) => [l.name, l.entry])).toEqual([['pad', 1]]);
+  });
+
+  it('draws an open window as long as its source plays, not to the song end', () => {
+    // riff is 4800 frames; the song here is 96000 samples long. An open
+    // window plays the source from its read offset to its end.
+    writeFileSync(
+      join(root, 'songs/creek/tracks/main.yaml'),
+      ['name: main', 'inputs:', '  - audio: riff', '  - audio: pad', '    source_offset: 1200', ''].join('\n'),
+    );
+    expect(lanesOf().map((l) => [l.name, l.duration])).toEqual([
+      ['riff', 4800],
+      ['pad', 3600],
+    ]);
+  });
+
+  it("draws a placed track's children where they sound, past its slip and source offset", () => {
+    // keys plays its render from source_offset - slip = 4800 - 1200 =
+    // 3600 at the window start (sample 0), so its child at local 0
+    // sounds at -3600 on the song's timeline.
+    createTrack(root, 'creek', 'keys');
+    writeFileSync(join(root, 'songs/creek/tracks/keys.yaml'), ['name: keys', 'inputs:', '  - audio: pad', ''].join('\n'));
+    writeFileSync(
+      join(root, 'songs/creek/tracks/main.yaml'),
+      ['name: main', 'inputs:', '  - track: keys', '    source_offset: 4800', '    slip: 1200', ''].join('\n'),
+    );
+    const [keys] = lanesOf();
+    expect(keys?.start).toBe(0);
+    expect(keys?.children?.map((l) => l.start)).toEqual([-3600]);
+  });
+});
diff --git a/src/commands/ui-timeline.ts b/src/commands/ui-timeline.ts
new file mode 100644
index 00000000..4e755939
--- /dev/null
+++ b/src/commands/ui-timeline.ts
@@ -0,0 +1,264 @@
+import { existsSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+import { readWav, readWavHeader } from '../audio/wav.js';
+import { placedWindow } from '../generators/stem.js';
+import type { LoadedSong } from '../model/project.js';
+import { barTicks, MeterMap, TempoMap } from '../time/tempo.js';
+import { sha256Text } from '../hash.js';
+import type { InputEntry, TrackTime } from '../schema/index.js';
+import type { UiInsert, UiMark, UiTimeline, UiTimelineLane } from './ui-protocol.js';
+
+// The song seen in time: a pure projection from the loaded project to
+// lanes with absolute sample windows, plus the bar marks the ruler
+// draws.
+//
+// From the files, not the compiled session, for the plan's reason: the
+// session is a build artifact whose shape depends on cache state, so a
+// frozen child's clips collapse into one rendered stem and lanes would
+// gain and lose their insides as the cache warms. The window is a fact
+// about the placement.
+//
+// The windows come from `placedWindow`, the planner's own function.
+// Re-deriving `at`/`duration` here would be a second implementation of
+// the arithmetic that decides where audio actually lands, and the two
+// would drift silently — the picture disagreeing with the render is the
+// one bug this view cannot afford, because the picture is the evidence.
+
+// Bars are not linear in samples: a tempo event may ramp, so a client
+// interpolating between two marks draws the grid wrong exactly where
+// the music is doing something interesting. Every bar gets its own
+// mark, projected through the real map.
+function barMarks(tempo: TempoMap, meter: MeterMap, lengthSamples: number): UiMark[] {
+  const marks: UiMark[] = [];
+  let bar = 1;
+  let tick = 0;
+  // Walk the meter segments the map already validated, using its own
+  // barTicks rather than recomputing a bar's length from numerator and
+  // denominator — the same reason the windows come from placedWindow.
+  // Bounded rather than while(true): a pathological map should not spin
+  // the server even though validation makes one unreachable.
+  for (let i = 0; i < 4096; i++) {
+    const sample = Math.round(tempo.ticksToSamples(tick));
+    if (sample > lengthSamples) break;
+    marks.push({ sample, bar });
+    let seg = 0;
+    while (seg + 1 < meter.events.length && meter.events[seg + 1]!.at <= tick) seg++;
+    const length = barTicks(meter.events[seg]!);
+    if (length <= 0) break;
+    tick += length;
+    bar++;
+  }
+  return marks;
+}
+
+// A source's header, or undefined while it is missing or mid-rename.
+function headerOf(path: string): { frames: number; sampleRate: number } | undefined {
+  try {
+    const { frames, sampleRate } = readWavHeader(path);
+    return { frames, sampleRate };
+  } catch {
+    return undefined;
+  }
+}
+
+// Peak envelope for a lane: the frames [from, to) of the source the
+// placement reads, in buckets across the drawn window.
+//
+// Deliberately the cheap half of waveforms. Doing them properly means a
+// peaks artifact with a build rule, a cache and an invalidation story —
+// a project of its own, and still the right answer for long material.
+// This computes the envelope on demand from the stem the build already
+// materialized and memoises it by that file's identity, which is enough
+// for songs of a few minutes and buys the picture its content now.
+const peakCache = new Map<string, number[]>();
+export function peaksFor(path: string, buckets: number, from = 0, to?: number): number[] | undefined {
+  if (!existsSync(path)) return undefined;
+  // Keyed on the artifact's own identity — size and modification time —
+  // rather than on anything about the song. An earlier version keyed on
+  // the session's total length, which does not move when a stem's
+  // contents change, so every same-length edit (a fader, a mute, an
+  // insert: nearly all of them) redrew the previous audio. The build
+  // materializes by rename and skips entirely when the bytes already
+  // match, so mtime moves exactly when the content does and not
+  // otherwise.
+  let key: string;
+  let wav;
+  try {
+    // Both reads race the same thing and need the same guard: the build
+    // replaces this artifact by rename while the view is asking about
+    // it, so it can vanish between the existsSync above and either call.
+    const stat = statSync(path);
+    key = `${path}:${stat.size}:${stat.mtimeMs}:${from}:${to ?? ''}`;
+    const cached = peakCache.get(key);
+    if (cached) return cached;
+    wav = readWav(path);
+  } catch {
+    return undefined; // an unreadable artifact is a lane without a picture
+  }
+  const total = wav.channels[0]?.length ?? 0;
+  const first = Math.min(from, total);
+  const end = Math.min(total, to ?? total);
+  const frames = end - first;
+  if (frames <= 0) return undefined;
+  const out: number[] = new Array(buckets).fill(0);
+  const per = frames / buckets;
+  for (let b = 0; b < buckets; b++) {
+    const from = first + Math.floor(b * per);
+    const to = Math.min(end, first + Math.floor((b + 1) * per));
+    let peak = 0;
+    // Stride large buckets: a 16-second stem at 48 k is 768 k frames and
+    // the envelope only needs the shape, not every sample.
+    const step = Math.max(1, Math.floor((to - from) / 512));
+    for (const ch of wav.channels) {
+      for (let i = from; i < to; i += step) {
+        const v = Math.abs(ch[i] ?? 0);
+        if (v > peak) peak = v;
+      }
+    }
+    out[b] = Math.min(1, peak);
+  }
+  peakCache.set(key, out);
+  if (peakCache.size > 64) peakCache.delete(peakCache.keys().next().value as string);
+  return out;
+}
+
+// The entries that draw a lane, each with its index in the document's
+// `inputs:` list. Receives draw none, so the lane list is shorter than
+// `inputs:` whenever one is present; every socket op addresses the
+// document by `entry`, so the index has to survive the filter rather
+// than be re-counted after it.
+function placements(inputs: InputEntry[]): Array<[InputEntry, number]> {
+  return inputs.flatMap((entry, i): Array<[InputEntry, number]> => (entry.receive === undefined ? [[entry, i]] : []));
+}
+
+export function projectTimeline(
+  root: string,
+  song: LoadedSong,
+  sessionRate: number,
+  lengthSamples: number,
+  peakBuckets: number,
+): UiTimeline {
+  const byName = new Map(song.tracks.map((t) => [t.data.name, t]));
+  const assetFile = (name: string): string | undefined => {
+    const row = song.assets?.data.assets.find((a) => a.name === name);
+    return row === undefined ? undefined : join(root, song.dir, row.file);
+  };
+  const main = byName.get('main');
+  const songTempo = new TempoMap(song.time?.tempo ?? [{ at: 0, bpm: 120 }], sessionRate);
+  const songMeter = new MeterMap(song.time?.meter ?? [{ at: 0, numerator: 4, denominator: 4 }]);
+
+  // One lane per placement, recursing into placed tracks. Depth is
+  // bounded by the track graph, which validation already proves acyclic;
+  // `seen` is a backstop so a project that somehow reached here with a
+  // cycle produces a truncated picture rather than a hung server.
+  const laneFor = (
+    // The LoadedFile itself: its `raw` is the exact text `data` was
+    // parsed from, which is what makes the hash below describe the
+    // document the lane was actually built out of. Re-reading the file
+    // here would let the lane's content come from one read and its
+    // stale guard from another, and an edit validated against the
+    // second would land on a document the view never rendered.
+    owner: { data: { name: string; inputs: InputEntry[]; time?: TrackTime | undefined }; path: string; raw: string },
+    entry: InputEntry,
+    index: number,
+    originSample: number,
+    depth: number,
+    seen: ReadonlySet<string>,
+  ): UiTimelineLane => {
+    // Everything in a track file is in that track's own time
+    // (nested-tracks.md §13), falling back to the song's.
+    const localTempo = owner.data.time?.tempo
+      ? new TempoMap(owner.data.time.tempo, sessionRate)
+      : songTempo;
+    const w = placedWindow(entry, localTempo);
+    const startSample = originSample + w.start;
+
+    const placedName = entry.track;
+    const placed = placedName !== undefined ? byName.get(placedName) : undefined;
+    // What the placement reads, where the view can find it: a placed
+    // track's rendered stem, or a song asset's file. The engine plays an
+    // open window for the source's length past the read offset
+    // (`source_offset - slip`, in source frames), so that, not the song's
+    // end, is how long an open window is, and the envelope is drawn from
+    // the slice the window reads rather than the whole source.
+    const sourcePath =
+      placedName !== undefined
+        ? join(root, '.field', 'out', song.dir, 'track', `${placedName}.wav`)
+        : entry.audio !== undefined
+          ? assetFile(entry.audio)
+          : undefined;
+    const source = sourcePath !== undefined ? headerOf(sourcePath) : undefined;
+    const readOffset = entry.source_offset - entry.slip;
+    const toSession = source ? sessionRate / source.sampleRate : 1;
+    const openLength = source
+      ? Math.round((source.frames - readOffset) * toSession)
+      : lengthSamples - startSample;
+    const duration = w.duration ?? Math.max(0, Math.min(openLength, lengthSamples - startSample));
+    const recurse = placed !== undefined && !seen.has(placedName!) && depth < 6;
+    // Where the placed track's own sample 0 falls on the timeline. The
+    // planner reads the placed render from `source_offset - slip`
+    // (stem.ts readOffsetFor), in the placed track's rate, so at the
+    // window start the listener hears that sample, not the track's zero.
+    // Children drawn from the window start would sit `slip` early, and a
+    // cut made where they sound would land that far off.
+    const childOrigin =
+      placed === undefined
+        ? startSample
+        : startSample -
+          Math.round(((entry.source_offset - entry.slip) * sessionRate) / (placed.data.rate ?? sessionRate));
+
+    return {
+      entry: index,
+      file: owner.path,
+      sha256: sha256Text(owner.raw),
+      name: placedName ?? entry.audio ?? entry.receive ??
+        (entry.supercollider ? 'supercollider' : entry.generative ? 'generative' : `input ${index + 1}`),
+      start: startSample,
+      duration,
+      depth,
+      gain_db: entry.gain_db,
+      pan: entry.pan,
+      mute: entry.mute,
+      canSolo: placedName !== undefined,
+      trackFile: placed?.path ?? null,
+      trackSha256: placed ? sha256Text(placed.raw) : null,
+      inserts: placed
+        ? placed.data.inserts.map(
+            (ins, i): UiInsert => ({
+              entry: i,
+              effect: 'effect' in ins ? String(ins.effect) : 'plugin',
+              // The whole parsed insert, defaults applied — the knobs
+              // render from real values, not from re-derived ones.
+              params: { ...ins },
+            }),
+          )
+        : null,
+      children: recurse
+        ? placements(placed!.data.inputs).map(([child, i]) =>
+            laneFor(placed!, child, i, childOrigin, depth + 1, new Set([...seen, placedName!])),
+          )
+        : null,
+      clips: [{ start: startSample, duration, exact: w.duration !== undefined, name: placedName ?? entry.audio ?? 'input' }],
+      peaks:
+        placedName === undefined || sourcePath === undefined
+          ? undefined
+          : peaksFor(
+              sourcePath,
+              peakBuckets,
+              Math.max(0, readOffset),
+              source ? Math.max(0, readOffset) + Math.round(duration / toSession) : undefined,
+            ),
+    };
+  };
+
+  const lanes = placements(main?.data.inputs ?? []).map(([entry, i]) =>
+    laneFor(main!, entry, i, 0, 0, new Set(['main'])),
+  );
+
+  return {
+    rate: sessionRate,
+    length: lengthSamples,
+    marks: barMarks(songTempo, songMeter, lengthSamples),
+    lanes,
+  };
+}
