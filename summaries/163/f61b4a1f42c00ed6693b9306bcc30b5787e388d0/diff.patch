new file mode 100644
index 00000000..06b95aff
--- /dev/null
+++ b/ui/src/Inserts.tsx
@@ -0,0 +1,336 @@
+import { useMemo, useRef, useState } from 'react';
+import type { UiInsert, UiTimelineLane } from '../../src/commands/ui-protocol.js';
+import { autoGainDb, responseDb, type EqBandLike } from '../../src/audio/eq-response.js';
+
+// The plugins panel: the selected lane's insert chain, at the bottom of
+// the window. Selection already exists for moving clips; this gives it
+// a second meaning — the chain shown is the selected track's — so the
+// panel needs no chooser of its own.
+//
+// Edits follow the fader's contract: local state exists only inside a
+// gesture, the file write lands on release, and the snapshot the server
+// pushes is what the controls believe afterwards. Every op speaks to
+// the track file under its own hash (lane.trackFile / trackSha256).
+//
+// The EQ editor draws its curve and its compensation readout from
+// src/audio/eq-response.ts, the engine's own arithmetic ported
+// line-for-line and held equal to the C++ by its tests — the picture
+// is the render's numbers, not a lookalike. Handles drag in
+// gain and frequency; bandwidth and type sit in the band strip below,
+// because two axes is what a drag has.
+
+const EFFECTS = ['eq', 'limit', 'reverb', 'plate', 'hall'] as const;
+
+// Knob ranges, mirrored from schema/effects.ts. The schema stays the
+// authority — the server revalidates every write against it — these
+// only shape the sliders.
+const KNOBS: Record<string, { key: string; min: number; max: number; step: number }[]> = {
+  limit: [
+    { key: 'ceiling_db', min: -24, max: 0, step: 0.1 },
+    { key: 'lookahead_ms', min: 0.1, max: 50, step: 0.1 },
+    { key: 'release_ms', min: 1, max: 2000, step: 1 },
+  ],
+  reverb: [
+    { key: 'mix', min: 0, max: 1, step: 0.01 },
+    { key: 'decay', min: 0.05, max: 30, step: 0.05 },
+    { key: 'predelay_ms', min: 0, max: 500, step: 1 },
+    { key: 'damping', min: 0, max: 1, step: 0.01 },
+  ],
+  plate: [
+    { key: 'mix', min: 0, max: 1, step: 0.01 },
+    { key: 'decay', min: 1, max: 30, step: 0.05 },
+    { key: 'predelay_ms', min: 0, max: 500, step: 1 },
+    { key: 'damping', min: 0, max: 1, step: 0.01 },
+    { key: 'diffusion', min: 0, max: 0.93, step: 0.01 },
+    { key: 'modulation', min: 0, max: 1, step: 0.01 },
+  ],
+  hall: [
+    { key: 'mix', min: 0, max: 1, step: 0.01 },
+    { key: 'decay', min: 1, max: 30, step: 0.05 },
+    { key: 'decay_low', min: 0.1, max: 4, step: 0.05 },
+    { key: 'decay_high', min: 0.1, max: 4, step: 0.05 },
+    { key: 'size', min: 0.1, max: 1, step: 0.01 },
+    { key: 'predelay_ms', min: 0, max: 500, step: 1 },
+    { key: 'diffusion', min: 0, max: 0.93, step: 0.01 },
+    { key: 'modulation', min: 0, max: 1, step: 0.01 },
+    { key: 'width', min: 0, max: 1, step: 0.01 },
+  ],
+};
+
+interface Props {
+  lane: UiTimelineLane;
+  sampleRate: number;
+  send: (msg: unknown) => void;
+}
+
+export function Inserts({ lane, sampleRate, send }: Props) {
+  const file = lane.trackFile;
+  const sha = lane.trackSha256;
+  if (file === null || sha === null || lane.inserts === null) return null;
+  const op = (msg: Record<string, unknown>) => send({ ...msg, file, sha256: sha });
+  return (
+    <div className="ins">
+      <div className="ins-head">
+        <span className="ins-track">{lane.name}</span>
+        <span className="ins-path">{file}</span>
+        <span className="ins-add">
+          {EFFECTS.map((e) => (
+            <button key={e} onClick={() => op({ type: 'insert-add', effect: e })}>
+              + {e}
+            </button>
+          ))}
+        </span>
+      </div>
+      {lane.inserts.length === 0 && <div className="ins-none">no inserts — add one above</div>}
+      {lane.inserts.map((ins) => (
+        <Insert key={ins.entry} ins={ins} sampleRate={sampleRate} op={op} />
+      ))}
+    </div>
+  );
+}
+
+function Insert({
+  ins,
+  sampleRate,
+  op,
+}: {
+  ins: UiInsert;
+  sampleRate: number;
+  op: (msg: Record<string, unknown>) => void;
+}) {
+  return (
+    <div className="ins-row">
+      <div className="ins-title">
+        <span className="ins-name">{ins.effect}</span>
+        <button
+          className="ins-remove"
+          title="remove this insert"
+          onClick={() => op({ type: 'insert-remove', entry: ins.entry })}
+        >
+          ×
+        </button>
+      </div>
+      {ins.effect === 'eq' ? (
+        <EqEditor ins={ins} sampleRate={sampleRate} op={op} />
+      ) : ins.effect === 'plugin' ? (
+        <div className="ins-none">a hosted plugin — its own editor owns these knobs</div>
+      ) : (
+        <Knobs ins={ins} op={op} />
+      )}
+    </div>
+  );
+}
+
+// Generic parameter strip: one slider per knob, committed on release.
+function Knobs({ ins, op }: { ins: UiInsert; op: (msg: Record<string, unknown>) => void }) {
+  const [drag, setDrag] = useState<Record<string, number>>({});
+  const knobs = KNOBS[ins.effect] ?? [];
+  // One write when the gesture ends, by pointer or by arrow keys.
+  const release = (key: string) => {
+    if (drag[key] !== undefined) {
+      op({ type: 'insert-edit', entry: ins.entry, set: { [key]: drag[key] } });
+      setDrag(({ [key]: _done, ...rest }) => rest);
+    }
+  };
+  return (
+    <div className="ins-knobs">
+      {knobs.map(({ key, min, max, step }) => {
+        const value = drag[key] ?? Number(ins.params[key] ?? 0);
+        return (
+          <label key={key} className="knob">
+            <span className="knob-name">{key.replace(/_/g, ' ')}</span>
+            <input
+              type="range"
+              min={min}
+              max={max}
+              step={step}
+              value={value}
+              onChange={(e) => setDrag({ ...drag, [key]: Number(e.target.value) })}
+              onPointerUp={() => release(key)}
+              onKeyUp={() => release(key)}
+            />
+            <span className="knob-value">{value}</span>
+          </label>
+        );
+      })}
+    </div>
+  );
+}
+
+// The EQ editor. The curve area is gain (±24 dB) against log frequency
+// (20 Hz–20 kHz); each band is a handle dragged in both. The strip
+// below the curve carries what the drag cannot: type, bandwidth, and
+// removal, for the band last touched.
+const FMIN = 20;
+const FMAX = 20000;
+const DBMAX = 24;
+const W = 560;
+const H = 150;
+
+function EqEditor({
+  ins,
+  sampleRate,
+  op,
+}: {
+  ins: UiInsert;
+  sampleRate: number;
+  op: (msg: Record<string, unknown>) => void;
+}) {
+  const saved = ins.params['bands'] as EqBandLike[];
+  // The gesture's own bands: null when idle, the whole array while a
+  // handle drags — one write on release, like the fader.
+  const [draft, setDraft] = useState<EqBandLike[] | null>(null);
+  const [picked, setPicked] = useState(0);
+  const grab = useRef<{ index: number } | null>(null);
+  const bands = draft ?? saved;
+  const normalize = ins.params['normalize'] !== false;
+
+  const fx = (f: number) => (Math.log(f / FMIN) / Math.log(FMAX / FMIN)) * W;
+  const xf = (x: number) => FMIN * Math.pow(FMAX / FMIN, Math.min(1, Math.max(0, x / W)));
+  const gy = (db: number) => H / 2 - (db / DBMAX) * (H / 2);
+  const yg = (y: number) => ((H / 2 - y) / (H / 2)) * DBMAX;
+
+  const curve = useMemo(() => {
+    const pts = responseDb(bands, sampleRate, 160);
+    return pts.map((p, i) => `${i ? 'L' : 'M'}${fx(p.frequency).toFixed(1)},${gy(p.db).toFixed(1)}`).join(' ');
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [bands, sampleRate]);
+  const compensation = useMemo(
+    () => (normalize ? autoGainDb(bands, sampleRate) : 0),
+    [bands, normalize, sampleRate],
+  );
+
+  const commit = (next: EqBandLike[]) => {
+    op({ type: 'insert-edit', entry: ins.entry, set: { bands: next } });
+    setDraft(null);
+  };
+
+  const onPointerMove = (e: React.PointerEvent<SVGSVGElement>) => {
+    const g = grab.current;
+    if (!g) return;
+    const box = e.currentTarget.getBoundingClientRect();
+    const x = ((e.clientX - box.left) / box.width) * W;
+    const y = ((e.clientY - box.top) / box.height) * H;
+    setDraft((d) => {
+      const base = d ?? saved;
+      return base.map((b, i) =>
+        i === g.index
+          ? {
+              ...b,
+              frequency: Math.round(xf(x)),
+              // Pass filters have no gain to drag; frequency is theirs.
+              ...(b.type === 'highpass' || b.type === 'lowpass'
+                ? {}
+                : { gain_db: Math.round(Math.max(-DBMAX, Math.min(DBMAX, yg(y))) * 2) / 2 }),
+            }
+          : b,
+      );
+    });
+  };
+
+  const band = bands[Math.min(picked, bands.length - 1)]!;
+  const setBand = (patch: Partial<EqBandLike>) => {
+    const next = bands.map((b, i) => (i === picked ? { ...b, ...patch } : b));
+    commit(next);
+  };
+
+  return (
+    <div className="eq">
+      <svg
+        viewBox={`0 0 ${W} ${H}`}
+        className="eq-view"
+        onPointerMove={onPointerMove}
+        onPointerUp={() => {
+          if (grab.current !== null && draft !== null) commit(draft);
+          grab.current = null;
+        }}
+        onPointerLeave={() => {
+          if (grab.current !== null && draft !== null) commit(draft);
+          grab.current = null;
+        }}
+      >
+        {/* Grid: octaves and 6 dB lines, quiet. */}
+        {[100, 1000, 10000].map((f) => (
+          <line key={f} x1={fx(f)} y1={0} x2={fx(f)} y2={H} className="eq-grid" />
+        ))}
+        {[-12, 0, 12].map((db) => (
+          <line key={db} x1={0} y1={gy(db)} x2={W} y2={gy(db)} className={db === 0 ? 'eq-zero' : 'eq-grid'} />
+        ))}
+        <path d={curve} className="eq-curve" />
+        {bands.map((b, i) => (
+          <circle
+            key={i}
+            cx={fx(b.frequency)}
+            cy={gy(b.type === 'highpass' || b.type === 'lowpass' ? 0 : (b.gain_db ?? 0))}
+            r={7}
+            className={`eq-handle ${i === picked ? 'picked' : ''}`}
+            onPointerDown={(e) => {
+              e.currentTarget.setPointerCapture(e.pointerId);
+              grab.current = { index: i };
+              setPicked(i);
+            }}
+          />
+        ))}
+      </svg>
+      <div className="eq-strip">
+        <select value={band.type} onChange={(e) => setBand({ type: e.target.value })}>
+          {['highpass', 'lowshelf', 'bell', 'highshelf', 'lowpass'].map((t) => (
+            <option key={t} value={t}>{t}</option>
+          ))}
+        </select>
+        <span className="knob-name">{Math.round(band.frequency)} Hz</span>
+        <label className="knob">
+          <span className="knob-name">width</span>
+          <input
+            type="range"
+            min={0.1}
+            max={8}
+            step={0.1}
+            value={band.bandwidth ?? 2}
+            // Held in the draft while the thumb moves, and written once
+            // on release, like the handles: a write per 0.1 step would
+            // swap the session each time and leave every later step
+            // refused as stale.
+            onChange={(e) => {
+              const bandwidth = Number(e.target.value);
+              setDraft(bands.map((b, i) => (i === picked ? { ...b, bandwidth } : b)));
+            }}
+            onPointerUp={() => {
+              if (draft !== null) commit(draft);
+            }}
+            onKeyUp={() => {
+              if (draft !== null) commit(draft);
+            }}
+          />
+          <span className="knob-value">{(band.bandwidth ?? 2).toFixed(1)} oct</span>
+        </label>
+        <button
+          onClick={() => commit(bands.filter((_, i) => i !== picked))}
+          disabled={bands.length <= 1}
+          title="remove this band"
+        >
+          − band
+        </button>
+        <button
+          onClick={() => commit([...bands, { type: 'bell', frequency: Math.round(band.frequency * 1.5) }])}
+          disabled={bands.length >= 8}
+          title="add a bell after the picked band"
+        >
+          + band
+        </button>
+        <label className="eq-norm" title="Fyra's auto-gain: EQ moves change tone, not level">
+          <input
+            type="checkbox"
+            checked={normalize}
+            onChange={(e) => op({ type: 'insert-edit', entry: ins.entry, set: { normalize: e.target.checked } })}
+          />
+          normalize
+        </label>
+        {/* No invisible gain, ever: the compensation is always shown. */}
+        <span className="eq-comp">
+          {normalize ? `${compensation >= 0 ? '+' : ''}${compensation.toFixed(1)} dB comp` : 'no comp'}
+        </span>
+      </div>
+    </div>
+  );
+}
diff --git a/ui/src/Timeline.tsx b/ui/src/Timeline.tsx
new file mode 100644
index 00000000..dac34ab7
--- /dev/null
+++ b/ui/src/Timeline.tsx
@@ -0,0 +1,393 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+// Real imports, not type-only: the grid the drag snaps to is the song's
+// own tempo arithmetic, the same functions the server projects bars
+// through — a client-side copy would drift from the ruler it snaps to.
+import { barTicks, MeterMap, TempoMap } from '../../src/time/tempo.js';
+import type { UiSnapshot, UiTimelineLane } from '../../src/commands/ui-protocol.js';
+
+// The song seen in time: headers on the left, lanes on one shared axis
+// to the right, under a bar ruler, with a playhead.
+//
+// One scroll container and two sticky axes: the header column sticks
+// left, the ruler row sticks top, and vertical scrolling therefore moves
+// both halves by construction. No scroll-sync handler exists to drift
+// out of step.
+//
+// A lane that places a track opens to show what is inside it — drums
+// into kick, snare and hats — one level per click, as deep as the tree
+// goes. Expansion is view state, held here and persisted nowhere: a
+// track placed in two homes opens independently in each, and both edit
+// the one file underneath, which is the same convergence argument that
+// put `mute:` on the placement.
+//
+// The gestures, and which one owns the playhead: clicking a clip
+// selects it, dragging a clip moves it in time, dragging either edge of
+// a clip trims it short or lets it play longer (all three snapped to the
+// beat grid and committed on release, as a `move` or a `stretch`), and
+// the playhead moves only from the ruler or a double-click on a clip.
+// The edges are grips rather than a hit test on the block, so the cursor
+// says which gesture the hand is about to start — and they appear only
+// on a block wide enough to hold them and still be draggable, since a
+// clip narrower than two grips could otherwise never be moved.
+//
+// A single click on a lane deliberately does nothing to the transport — locating on every stray
+// click made selecting a clip impossible without also moving the play
+// position, which is how the first version worked and why it stopped.
+//
+// The view follows the playhead while it moves: once the head crosses
+// the middle of the viewport the scroll position tracks it, which is
+// the conveyor a DAW runs during playback. A manual scroll wins for a
+// moment — the hold below — so looking at another part of the song is
+// never a fight with the transport.
+
+// The header column's width, shared by the CSS grid template and every
+// piece of arithmetic that has to know where lane content begins.
+const HEADER_PX = 200;
+
+// Which edge a drag is holding. A move holds the start and carries the
+// whole window; the other two change the window's length.
+type Edge = 'move' | 'start' | 'end';
+
+// The grip's width, and the unit the "is this block wide enough" test is
+// written in — one number so the two cannot disagree.
+const GRIP_PX = 7;
+
+// Zoom, fixed for now: enough that a song longer than the window keeps
+// scrolling as it plays, while a short one stretches to fill (below).
+const PX_PER_SECOND = 100;
+
+// Find a lane again by its tree path — the shape the walk below
+// builds. The panel holds a path rather than a lane object, so each
+// snapshot re-resolves it and edits always read current values.
+export function laneAt(lanes: UiTimelineLane[], path: string, prefix = ''): UiTimelineLane | null {
+  for (const lane of lanes) {
+    const p = `${prefix}/${lane.entry}:${lane.name}`;
+    if (p === path) return lane;
+    if (lane.children && path.startsWith(p + '/')) {
+      const hit = laneAt(lane.children, path, p);
+      if (hit) return hit;
+    }
+  }
+  return null;
+}
+
+interface Props {
+  snap: UiSnapshot;
+  playSample: number;
+  // Selection lives in App — the inserts panel reads it too — and the
+  // timeline is one of its writers.
+  selected: string | null;
+  onSelect: (path: string | null) => void;
+  onLocate: (sample: number) => void;
+  onMove: (lane: UiTimelineLane, deltaSamples: number) => void;
+  // The end edge commits the window's new length, the start edge how far
+  // it travelled — one measurement from the clip's own window start,
+  // which is what the server's op takes (ui-edits.ts).
+  onStretch: (lane: UiTimelineLane, edge: 'start' | 'end', offset: number) => void;
+  controls: (lane: UiTimelineLane) => React.ReactNode;
+}
+
+export function Timeline({ snap, playSample, selected, onSelect, onLocate, onMove, onStretch, controls }: Props) {
+  // Keyed by path through the tree, so the same track opens separately
+  // in each home it is placed in.
+  const [open, setOpen] = useState<Record<string, boolean>>({});
+  // While a drag is live, the dragged clip renders with its edge moved
+  // by delta — the whole block for a move, one side for a stretch. The
+  // write happens once, on release.
+  const [drag, setDrag] = useState<{ path: string; edge: Edge; delta: number } | null>(null);
+  const grab = useRef<
+    { x: number; path: string; lane: UiTimelineLane; edge: Edge; active: boolean } | null
+  >(null);
+  const scroller = useRef<HTMLDivElement | null>(null);
+  // A manual scroll holds off the auto-follow until this timestamp, so
+  // the conveyor never yanks the view back mid-gesture.
+  const holdUntil = useRef(0);
+  // Measured, not assumed: the lane area is whatever the window gives
+  // it, and a short song stretches to exactly that.
+  const [viewWidth, setViewWidth] = useState(1200);
+  useLayoutEffect(() => {
+    const el = scroller.current;
+    if (!el) return;
+    const measure = () => setViewWidth(el.clientWidth);
+    measure();
+    const ro = new ResizeObserver(measure);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+
+  // The snap grid: the song's beat positions, through the real maps.
+  // Beats rather than bars — bars are the ruler's resolution, and a
+  // clip that can only land on a barline cannot make a pickup.
+  const clock = snap.clock;
+  const grid = useMemo(
+    () =>
+      clock
+        ? { tempo: new TempoMap(clock.tempo, clock.sampleRate), meter: new MeterMap(clock.meter) }
+        : null,
+    [clock],
+  );
+  const snapSample = (sample: number): number => {
+    if (!grid) return Math.max(0, Math.round(sample));
+    const ticks = grid.tempo.samplesToTicks(Math.max(0, sample));
+    let seg = 0;
+    while (seg + 1 < grid.meter.events.length && grid.meter.events[seg + 1]!.at <= ticks) seg++;
+    const ev = grid.meter.events[seg]!;
+    const beat = barTicks(ev) / ev.numerator;
+    const snapped = Math.max(0, ev.at + Math.round((ticks - ev.at) / beat) * beat);
+    return Math.max(0, Math.round(grid.tempo.ticksToSamples(snapped)));
+  };
+
+  const tl = snap.timeline;
+  const length = tl?.length ?? 0;
+  // A song shorter than the window fills it; a longer one gets the
+  // fixed zoom and scrolls. Declared before the effect below so hook
+  // order never depends on the snapshot's contents.
+  const pxPerSample = tl
+    ? Math.max((viewWidth - HEADER_PX) / length, PX_PER_SECOND / tl.rate)
+    : 0;
+  const x = (sample: number) => sample * pxPerSample;
+  const width = x(length);
+
+  // Follow the playhead. playSample only moves while playing or on a
+  // locate, so this is idle exactly when the transport is.
+  useEffect(() => {
+    const el = scroller.current;
+    if (!el || performance.now() < holdUntil.current) return;
+    const view = el.clientWidth - HEADER_PX;
+    const head = x(playSample);
+    if (head - el.scrollLeft > view * 0.5) {
+      el.scrollLeft = head - view * 0.5; // the conveyor: head pinned mid-view
+    } else if (head < el.scrollLeft) {
+      el.scrollLeft = Math.max(0, head - view * 0.15); // jumped back: catch up
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [playSample]);
+
+  if (!tl || length <= 0) return null;
+
+  // Locate from a horizontal position inside any lane-width element:
+  // the ruler on a single click, a clip on a double.
+  const locateAt = (clientX: number, laneEl: HTMLElement) => {
+    const box = laneEl.getBoundingClientRect();
+    const sample = Math.max(0, Math.round((clientX - box.left) / pxPerSample));
+    onLocate(Math.min(sample, length));
+  };
+
+  const onGrab = (
+    e: React.PointerEvent<HTMLDivElement>,
+    lane: UiTimelineLane,
+    path: string,
+    edge: Edge,
+  ) => {
+    if (e.button !== 0) return;
+    e.stopPropagation();
+    onSelect(path);
+    grab.current = { x: e.clientX, path, lane, edge, active: false };
+    e.currentTarget.setPointerCapture(e.pointerId);
+  };
+  const onDragMove = (e: React.PointerEvent<HTMLDivElement>) => {
+    const g = grab.current;
+    if (!g) return;
+    const dx = e.clientX - g.x;
+    // A click is not yet a drag: a few pixels of hand tremor must not
+    // become a file write.
+    if (!g.active && Math.abs(dx) < 4) return;
+    g.active = true;
+    holdUntil.current = performance.now() + 1500; // the conveyor yields to the hand
+    // Whichever edge the hand is holding, snapped to the grid and read
+    // back as a delta from where that edge started — a move holds the
+    // start and carries the whole window with it.
+    const held = g.edge === 'end' ? g.lane.start + g.lane.duration : g.lane.start;
+    const delta = snapSample(held + dx / pxPerSample) - held;
+    // A window never closes to nothing under the hand. The drag simply
+    // stops following at the last grid step that leaves a window, rather
+    // than clamping to a position no snap would have produced.
+    if (g.edge === 'start' && delta >= g.lane.duration) return;
+    if (g.edge === 'end' && delta <= -g.lane.duration) return;
+    setDrag({ path: g.path, edge: g.edge, delta });
+  };
+  const onDrop = () => {
+    const g = grab.current;
+    grab.current = null;
+    if (g?.active && drag !== null && drag.delta !== 0) {
+      if (g.edge === 'move') onMove(g.lane, drag.delta);
+      else if (g.edge === 'end') onStretch(g.lane, 'end', g.lane.duration + drag.delta);
+      else onStretch(g.lane, 'start', drag.delta);
+    }
+    setDrag(null);
+  };
+  const onDragCancel = () => {
+    grab.current = null;
+    setDrag(null);
+  };
+
+  // Flatten the visible tree: a child only appears when every ancestor
+  // is open, so one pass over this array renders the grid in order.
+  const rows: { lane: UiTimelineLane; path: string }[] = [];
+  const walk = (lanes: UiTimelineLane[], prefix: string) => {
+    for (const lane of lanes) {
+      const path = `${prefix}/${lane.entry}:${lane.name}`;
+      rows.push({ lane, path });
+      if (open[path] && lane.children) walk(lane.children, path);
+    }
+  };
+  walk(tl.lanes, '');
+
+  return (
+    <div className="tl">
+      <div
+        className="tl-scroll"
+        ref={scroller}
+        onWheel={() => {
+          holdUntil.current = performance.now() + 1500;
+        }}
+      >
+        <div className="tl-grid" style={{ width: HEADER_PX + width }}>
+          <div className="tl-corner" />
+          {/* One tick per bar, drawn where the server says the bar falls:
+              bars are not linear in samples across a tempo ramp. */}
+          <div
+            className="tl-ruler"
+            style={{ width }}
+            onClick={(e) => locateAt(e.clientX, e.currentTarget)}
+          >
+            {tl.marks.map((m) => (
+              <div key={m.bar} className="tl-mark" style={{ left: x(m.sample) }}>
+                <span>{m.bar}</span>
+              </div>
+            ))}
+            <div className="tl-head" style={{ left: x(playSample) }} />
+          </div>
+
+          {rows.map(({ lane, path }) => (
+            <Row
+              key={path}
+              lane={lane}
+              open={open[path] === true}
+              onToggle={() => setOpen((o) => ({ ...o, [path]: !o[path] }))}
+              width={width}
+              x={x}
+              playSample={playSample}
+              selected={selected === path}
+              drag={drag?.path === path ? drag : null}
+              onGrab={(e, edge) => onGrab(e, lane, path, edge)}
+              onDragMove={onDragMove}
+              onDrop={onDrop}
+              onDragCancel={onDragCancel}
+              onDeselect={() => onSelect(null)}
+              locateAt={locateAt}
+              controls={controls}
+            />
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function Row({
+  lane, open, onToggle, width, x, playSample, selected, drag,
+  onGrab, onDragMove, onDrop, onDragCancel, onDeselect, locateAt, controls,
+}: {
+  lane: UiTimelineLane;
+  open: boolean;
+  onToggle: () => void;
+  width: number;
+  x: (s: number) => number;
+  playSample: number;
+  selected: boolean;
+  drag: { edge: Edge; delta: number } | null;
+  onGrab: (e: React.PointerEvent<HTMLDivElement>, edge: Edge) => void;
+  onDragMove: (e: React.PointerEvent<HTMLDivElement>) => void;
+  onDrop: () => void;
+  onDragCancel: () => void;
+  onDeselect: () => void;
+  locateAt: (clientX: number, laneEl: HTMLElement) => void;
+  controls: (lane: UiTimelineLane) => React.ReactNode;
+}) {
+  const peaks = lane.peaks;
+  // One delta, read three ways: a move carries both edges, a start drag
+  // moves the left edge and eats into the window, an end drag leaves the
+  // left edge where it is and changes the length.
+  const delta = drag?.delta ?? 0;
+  const start = drag?.edge === 'end' ? lane.start : lane.start + delta;
+  const duration =
+    drag === null || drag.edge === 'move'
+      ? lane.duration
+      : drag.edge === 'end'
+        ? lane.duration + delta
+        : lane.duration - delta;
+  const stretching = drag !== null && drag.edge !== 'move';
+  // Two grips and room to grab the block between them: below that the
+  // clip is all handle and nothing to drag, so the edges step aside.
+  const grips = x(duration) >= 3 * GRIP_PX;
+  return (
+    <>
+      <div className="tl-header" style={{ paddingLeft: 6 + lane.depth * 14 }}>
+        {lane.children ? (
+          <button className="twirl" onClick={onToggle} title={open ? 'collapse' : 'expand'}>
+            {open ? '▾' : '▸'}
+          </button>
+        ) : (
+          <span className="twirl-spacer" />
+        )}
+        {controls(lane)}
+      </div>
+      {/* A click on empty lane ground only clears the selection — the
+          playhead belongs to the ruler and to double-clicks. */}
+      <div className="tl-lane" style={{ width }} onClick={onDeselect}>
+        <div
+          className={[
+            'tl-block',
+            lane.mute ? 'muted' : '',
+            selected ? 'selected' : '',
+            drag !== null ? 'dragging' : '',
+            stretching ? 'stretching' : '',
+            `d${Math.min(lane.depth, 3)}`,
+          ].join(' ')}
+          style={{ left: x(start), width: Math.max(2, x(duration)) }}
+          onClick={(e) => e.stopPropagation()}
+          onPointerDown={(e) => onGrab(e, 'move')}
+          onPointerMove={onDragMove}
+          onPointerUp={onDrop}
+          onPointerCancel={onDragCancel}
+          onDoubleClick={(e) => {
+            const laneEl = e.currentTarget.closest('.tl-lane');
+            if (laneEl instanceof HTMLElement) locateAt(e.clientX, laneEl);
+          }}
+        >
+          {grips &&
+            (['start', 'end'] as const).map((edge) => (
+              <div
+                key={edge}
+                className={`tl-grip ${edge}`}
+                title={edge === 'start' ? 'trim the front (moves what it reads)' : 'trim the end'}
+                onPointerDown={(e) => onGrab(e, edge)}
+                onPointerMove={onDragMove}
+                onPointerUp={onDrop}
+                onPointerCancel={onDragCancel}
+              />
+            ))}
+          {peaks && (
+            <svg className="tl-wave" viewBox={`0 0 ${peaks.length} 100`} preserveAspectRatio="none">
+              {/* Mirrored envelope: the shape of the render, not a claim
+                  about individual samples. */}
+              <path
+                d={
+                  `M0,50 ` +
+                  peaks.map((p, i) => `L${i},${50 - p * 46}`).join(' ') +
+                  peaks.map((_, i) => {
+                    const j = peaks.length - 1 - i;
+                    return `L${j},${50 + (peaks[j] ?? 0) * 46}`;
+                  }).join(' ') +
+                  ' Z'
+                }
+              />
+            </svg>
+          )}
+        </div>
+        <div className="tl-head" style={{ left: x(playSample) }} />
+      </div>
+    </>
+  );
+}
diff --git a/ui/src/app.css b/ui/src/app.css
new file mode 100644
index 00000000..bf239c87
--- /dev/null
+++ b/ui/src/app.css
@@ -0,0 +1,525 @@
+:root {
+  color-scheme: dark;
+  font-family: ui-sans-serif, system-ui, sans-serif;
+}
+html,
+body,
+#root {
+  height: 100%;
+}
+body {
+  margin: 0;
+  background: #14161a;
+  color: #d7dae0;
+}
+main {
+  height: 100%;
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  padding: 0.75rem 1rem;
+}
+.empty {
+  opacity: 0.6;
+  padding: 3rem;
+}
+header {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding-bottom: 0.75rem;
+  border-bottom: 1px solid #2a2e36;
+}
+.song {
+  font-weight: 600;
+}
+header button:disabled {
+  opacity: 0.35;
+  cursor: default;
+}
+header button {
+  background: #22262e;
+  color: inherit;
+  border: 1px solid #343945;
+  border-radius: 4px;
+  padding: 0.25rem 0.6rem;
+  cursor: pointer;
+  font-size: 1rem;
+}
+.state.playing {
+  color: #6fd08c;
+}
+.position {
+  font-variant-numeric: tabular-nums;
+  margin-left: auto;
+}
+header select {
+  background: #22262e;
+  color: inherit;
+  border: 1px solid #343945;
+  border-radius: 4px;
+  padding: 0.2rem;
+  max-width: 16rem;
+}
+.error {
+  display: flex;
+  align-items: flex-start;
+  gap: 0.75rem;
+  background: #3a2226;
+  border: 1px solid #6b3038;
+  padding: 0.5rem 0.75rem;
+  margin-top: 0.75rem;
+  border-radius: 4px;
+  white-space: pre-wrap;
+}
+.error span {
+  flex: 1;
+}
+.error .dismiss {
+  background: none;
+  border: none;
+  color: inherit;
+  cursor: pointer;
+  font-size: 1.1rem;
+  line-height: 1;
+  opacity: 0.7;
+  padding: 0;
+}
+.lanes {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin-top: 0.75rem;
+}
+.lane {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+  background: #1b1e24;
+  border: 1px solid #262a32;
+  border-radius: 4px;
+  padding: 0.5rem 0.75rem;
+}
+.lane.muted .name,
+.lane.dimmed {
+  opacity: 0.45;
+}
+.lane .name {
+  width: 8rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.lane button {
+  width: 1.7rem;
+  height: 1.7rem;
+  border-radius: 4px;
+  border: 1px solid #343945;
+  background: #22262e;
+  color: inherit;
+  cursor: pointer;
+}
+.lane button.mute.on {
+  background: #7a4048;
+  border-color: #a05560;
+}
+.lane button.solo.on {
+  background: #6f6430;
+  border-color: #998a45;
+}
+.gain {
+  flex: 1;
+}
+.db {
+  width: 4.5rem;
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
+.pan {
+  width: 6rem;
+}
+.inserts {
+  font-size: 0.8rem;
+  opacity: 0.6;
+}
+footer {
+  margin-top: 1rem;
+  font-size: 0.8rem;
+  opacity: 0.5;
+}
+
+.empty-tag {
+  font-size: 0.7rem;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  opacity: 0.5;
+  border: 1px solid #3a3f4a;
+  border-radius: 3px;
+  padding: 0 0.3rem;
+}
+
+/* --- timeline ------------------------------------
+   One scroller, two sticky axes: the header column sticks left, the
+   ruler row sticks top, so vertical scroll moves both halves and no
+   sync handler can drift. */
+.tl {
+  margin-top: 0.75rem;
+  border: 1px solid #262a32;
+  border-radius: 4px;
+  overflow: hidden;
+  /* The timeline is the window's body: whatever height the header and
+     footer leave belongs to it. */
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.tl-scroll {
+  overflow: auto;
+  flex: 1;
+  min-height: 0;
+  /* Scrolling is the trackpad's job in both axes; the bars themselves
+     are chrome the view does not need. */
+  scrollbar-width: none;
+}
+.tl-scroll::-webkit-scrollbar {
+  display: none;
+}
+.tl-grid {
+  display: grid;
+  grid-template-columns: 200px 1fr;
+}
+.tl-corner {
+  position: sticky;
+  left: 0;
+  top: 0;
+  z-index: 3;
+  background: #1b1e24;
+  border-right: 1px solid #262a32;
+  border-bottom: 1px solid #262a32;
+}
+.tl-ruler {
+  position: sticky;
+  top: 0;
+  z-index: 2;
+  height: 26px;
+  background: #1b1e24;
+  border-bottom: 1px solid #262a32;
+  cursor: pointer;
+}
+.tl-mark {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  border-left: 1px solid #333945;
+  padding-left: 3px;
+  font-size: 0.7rem;
+  opacity: 0.65;
+  line-height: 26px;
+}
+.tl-header {
+  position: sticky;
+  left: 0;
+  z-index: 1;
+  background: #1b1e24;
+  border-right: 1px solid #262a32;
+  border-bottom: 1px solid #23272f;
+  display: flex;
+  align-items: center;
+  height: 64px;
+  box-sizing: border-box;
+  /* Nothing in the header column may bleed over the lanes beside it. */
+  overflow: hidden;
+}
+.tl-lane {
+  position: relative;
+  /* Its own stacking context, so nothing inside a lane (the edge grips
+     sit at z-index 1) can rise above the sticky header column and take
+     a press meant for a fader. */
+  isolation: isolate;
+  border-bottom: 1px solid #23272f;
+  cursor: pointer;
+  height: 64px;
+  box-sizing: border-box;
+}
+.tl-block {
+  position: absolute;
+  top: 4px;
+  bottom: 4px;
+  background: #223042;
+  border: 1px solid #2f4258;
+  border-radius: 3px;
+  overflow: hidden;
+  cursor: grab;
+}
+.tl-block.selected {
+  border-color: #e8c35a;
+  box-shadow: 0 0 0 1px rgba(232, 195, 90, 0.45);
+}
+.tl-block.dragging {
+  cursor: grabbing;
+  opacity: 0.85;
+}
+.tl-block.stretching {
+  cursor: ew-resize;
+}
+/* The window's own edges, grabbable: drag one and the clip trims short
+   or plays longer, snapped to the grid a move lands on. Visible on
+   hover rather than always, so a lane of clips reads as clips. */
+.tl-grip {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 7px;
+  z-index: 1;
+  cursor: ew-resize;
+}
+.tl-grip.start {
+  left: 0;
+}
+.tl-grip.end {
+  right: 0;
+}
+.tl-grip:hover {
+  background: rgba(232, 195, 90, 0.4);
+}
+.tl-wave {
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+.tl-wave path {
+  fill: #5b8fc7;
+  opacity: 0.85;
+}
+.tl-clip {
+  position: absolute;
+  top: 2px;
+  bottom: 2px;
+  border-left: 1px solid #6d86a8;
+  pointer-events: none;
+}
+.tl-clip.inexact {
+  border-left-style: dashed;
+}
+.tl-head {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  margin-left: -1px;
+  background: #e8c35a;
+  pointer-events: none;
+  z-index: 4;
+}
+
+.twirl {
+  background: none;
+  border: none;
+  color: inherit;
+  cursor: pointer;
+  width: 1.1rem;
+  padding: 0;
+  opacity: 0.75;
+  font-size: 0.8rem;
+}
+.twirl-spacer {
+  display: inline-block;
+  width: 1.1rem;
+}
+.tl-header .lane {
+  background: none;
+  border: none;
+  padding: 0.25rem 0.4rem;
+  flex: 1;
+  min-width: 0;
+  flex-direction: column;
+  align-items: stretch;
+  justify-content: center;
+  gap: 2px;
+}
+.tl-header .lane .name {
+  width: auto;
+  min-width: 0;
+  font-size: 0.85rem;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.lane-ctl {
+  display: flex;
+  align-items: center;
+  gap: 0.35rem;
+  min-width: 0;
+}
+.lane-ctl button {
+  width: 1.5rem;
+  height: 1.5rem;
+  flex: none;
+  font-size: 0.75rem;
+}
+.tl-header .lane .gain {
+  flex: 1;
+  min-width: 0;
+}
+.tl-header .lane .db {
+  flex: none;
+  width: 2.4rem;
+  font-size: 0.75rem;
+}
+.tl-block.muted {
+  opacity: 0.3;
+}
+.tl-block.d1 { background: #24313d; }
+.tl-block.d2 { background: #26303a; }
+.tl-block.d3 { background: #272f36; }
+
+/* --- inserts panel -------------------------------
+   The selected track's chain, at the bottom. Appears with selection,
+   leaves with Escape; the timeline above keeps the rest of the window. */
+.ins {
+  flex: none;
+  max-height: 300px;
+  overflow-y: auto;
+  margin-top: 0.5rem;
+  border: 1px solid #262a32;
+  border-radius: 4px;
+  background: #171a1f;
+  padding: 0.5rem 0.75rem;
+  scrollbar-width: none;
+}
+.ins::-webkit-scrollbar {
+  display: none;
+}
+.ins-head {
+  display: flex;
+  align-items: center;
+  gap: 0.6rem;
+}
+.ins-track {
+  font-weight: 600;
+}
+.ins-path {
+  font-size: 0.75rem;
+  opacity: 0.5;
+}
+.ins-add {
+  margin-left: auto;
+  display: flex;
+  gap: 0.3rem;
+}
+.ins-add button,
+.eq-strip button,
+.eq-strip select {
+  background: #22262e;
+  color: inherit;
+  border: 1px solid #343945;
+  border-radius: 4px;
+  padding: 0.15rem 0.5rem;
+  cursor: pointer;
+  font-size: 0.8rem;
+}
+.ins-none {
+  opacity: 0.5;
+  font-size: 0.85rem;
+  padding: 0.5rem 0;
+}
+.ins-row {
+  border-top: 1px solid #23272f;
+  margin-top: 0.5rem;
+  padding-top: 0.4rem;
+}
+.ins-title {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+}
+.ins-name {
+  font-size: 0.85rem;
+  font-weight: 600;
+}
+.ins-remove {
+  background: none;
+  border: none;
+  color: inherit;
+  opacity: 0.6;
+  cursor: pointer;
+  font-size: 1rem;
+  padding: 0 0.2rem;
+}
+.ins-knobs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.3rem 1rem;
+  padding: 0.3rem 0;
+}
+.knob {
+  display: flex;
+  align-items: center;
+  gap: 0.4rem;
+  font-size: 0.78rem;
+}
+.knob input[type='range'] {
+  width: 110px;
+}
+.knob-name {
+  opacity: 0.65;
+  white-space: nowrap;
+}
+.knob-value {
+  font-variant-numeric: tabular-nums;
+  min-width: 2.6rem;
+}
+
+/* --- the EQ editor -------------------------------- */
+.eq-view {
+  width: 100%;
+  max-width: 720px;
+  height: 150px;
+  display: block;
+  background: #14161a;
+  border: 1px solid #262a32;
+  border-radius: 4px;
+  touch-action: none;
+}
+.eq-grid {
+  stroke: #23272f;
+  stroke-width: 1;
+}
+.eq-zero {
+  stroke: #343945;
+  stroke-width: 1;
+}
+.eq-curve {
+  fill: none;
+  stroke: #5b8fc7;
+  stroke-width: 2;
+}
+.eq-handle {
+  fill: #22262e;
+  stroke: #6d86a8;
+  stroke-width: 1.5;
+  cursor: grab;
+}
+.eq-handle.picked {
+  fill: #e8c35a;
+  stroke: #e8c35a;
+}
+.eq-strip {
+  display: flex;
+  align-items: center;
+  gap: 0.7rem;
+  padding: 0.35rem 0;
+  flex-wrap: wrap;
+  font-size: 0.8rem;
+}
+.eq-norm {
+  display: flex;
+  align-items: center;
+  gap: 0.3rem;
+  opacity: 0.85;
+}
+.eq-comp {
+  font-variant-numeric: tabular-nums;
+  color: #e8c35a;
+}
diff --git a/ui/src/main.tsx b/ui/src/main.tsx
new file mode 100644
index 00000000..25472232
--- /dev/null
+++ b/ui/src/main.tsx
@@ -0,0 +1,32 @@
+import { createRoot } from 'react-dom/client';
+import { App } from './App.js';
+import './app.css';
+
+// A blank window is the one failure mode with no diagnosis in it: the
+// page cannot say what went wrong, and in a desktop shell there is no
+// console to open. So anything that escapes React lands on the page
+// itself, and the shell mirrors it to the terminal it was launched from.
+function fatal(what: string, detail: unknown): void {
+  const message = detail instanceof Error ? `${detail.message}\n${detail.stack ?? ''}` : String(detail);
+  const root = document.getElementById('root');
+  if (root) {
+    root.innerHTML =
+      `<pre style="padding:2rem;color:#ff9aa5;white-space:pre-wrap;font:13px ui-monospace,monospace">` +
+      `${what}\n\n${message.replace(/[<&]/g, (c) => (c === '<' ? '&lt;' : '&amp;'))}</pre>`;
+  }
+  console.error(what, detail);
+}
+
+window.addEventListener('error', (e) => fatal('Uncaught error', e.error ?? e.message));
+window.addEventListener('unhandledrejection', (e) => fatal('Unhandled rejection', e.reason));
+
+const container = document.getElementById('root');
+if (!container) {
+  document.body.textContent = 'field ui: #root is missing from the page';
+} else {
+  try {
+    createRoot(container).render(<App />);
+  } catch (err) {
+    fatal('React failed to mount', err);
+  }
+}
