+++ b/src/schema/keymap.test.ts
@@ -0,0 +1,192 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { parseDocument } from 'yaml';
+import { builtinKeymapDir } from '../keys/keymap.js';
+import { keymapSchema, toKeymap } from './keymap.js';
+
+// The tracker and fourths keymaps ship in chunk 3 (keyboard-instrument.md
+// §6); carrying them here proves the format expresses both before then.
+const TRACKER = `
+name: tracker
+description: Two piano octaves on the bottom and top rows, black keys on the row above each.
+base: 48
+notes:
+  KeyZ: 0
+  KeyS: 1
+  KeyX: 2
+  KeyD: 3
+  KeyC: 4
+  KeyV: 5
+  KeyG: 6
+  KeyB: 7
+  KeyH: 8
+  KeyN: 9
+  KeyJ: 10
+  KeyM: 11
+  Comma: 12
+  KeyL: 13
+  Period: 14
+  Semicolon: 15
+  Slash: 16
+  KeyQ: 12
+  Digit2: 13
+  KeyW: 14
+  Digit3: 15
+  KeyE: 16
+  KeyR: 17
+  Digit5: 18
+  KeyT: 19
+  Digit6: 20
+  KeyY: 21
+  Digit7: 22
+  KeyU: 23
+  KeyI: 24
+  Digit9: 25
+  KeyO: 26
+  Digit0: 27
+  KeyP: 28
+  BracketLeft: 29
+  Equal: 30
+  BracketRight: 31
+controls:
+  ArrowLeft: { transpose: -12 }
+  ArrowRight: { transpose: 12 }
+  ArrowDown: { velocity: -20 }
+  ArrowUp: { velocity: 20 }
+  Space: { cc: 64, value: 127, mode: hold }
+`;
+
+const FOURTHS = `
+name: fourths
+description: One semitone per key, each row a fourth above the row below.
+base: 48
+grid: { rows: [bottom, home, top, number], column: 1, row: 5 }
+controls:
+  ArrowLeft: { transpose: -12 }
+  ArrowRight: { transpose: 12 }
+  ArrowDown: { velocity: -20 }
+  ArrowUp: { velocity: 20 }
+  Space: { cc: 64, value: 127, mode: hold }
+`;
+
+function parse(text: string) {
+  return keymapSchema.safeParse(parseDocument(text).toJS());
+}
+
+function keymap(text: string) {
+  const result = parse(text);
+  if (!result.success) throw new Error(result.error.issues.map((i) => i.message).join('; '));
+  return toKeymap(result.data);
+}
+
+function messages(text: string): string[] {
+  const result = parse(text);
+  expect(result.success).toBe(false);
+  return result.success ? [] : result.error.issues.map((i) => i.message);
+}
+
+function notesPlayed(map: ReturnType<typeof keymap>): Set<number> {
+  return new Set([...map.notes.values()].flat().map((o) => map.base + o));
+}
+
+describe('keymap schema', () => {
+  it('accepts musical-typing with its 18 notes and the defaults', () => {
+    const map = keymap(readFileSync(join(builtinKeymapDir(), 'musical-typing.yaml'), 'utf8'));
+    expect(map.notes.get('KeyA')).toEqual([0]);
+    expect(map.notes.get('Quote')).toEqual([17]);
+    expect(notesPlayed(map).size).toBe(18);
+    expect(map.velocity).toBe(100);
+    expect(map.channel).toBe(1);
+    expect(map.controls.get('Tab')).toEqual({ cc: 64, value: 127, mode: 'hold' });
+    expect(map.controls.get('KeyZ')).toEqual({ transpose: -12 });
+  });
+
+  it('accepts the tracker fixture with 32 notes', () => {
+    const map = keymap(TRACKER);
+    expect(notesPlayed(map).size).toBe(32);
+    expect(map.base + map.notes.get('KeyZ')![0]!).toBe(48);
+    expect(map.base + map.notes.get('KeyQ')![0]!).toBe(60);
+    expect(map.base + map.notes.get('KeyI')![0]!).toBe(72);
+  });
+
+  it('expands the fourths grid', () => {
+    const map = keymap(FOURTHS);
+    const at = (p: string) => map.base + map.notes.get(p)![0]!;
+    expect(at('KeyZ')).toBe(48);
+    expect(at('KeyA')).toBe(53);
+    expect(at('KeyQ')).toBe(58);
+    expect(at('Digit1')).toBe(63);
+    expect([at('KeyZ'), at('KeyB'), at('KeyD')]).toEqual([48, 52, 55]);
+    expect([at('KeyX'), at('KeyN'), at('KeyF')]).toEqual([49, 53, 56]);
+    expect(notesPlayed(map).size).toBe(27);
+  });
+
+  it('lets notes override the grid and controls take positions back from it', () => {
+    const map = keymap(`
+name: mixed
+grid: { rows: [bottom], column: 2, row: 0 }
+notes: { KeyX: 9 }
+controls: { KeyZ: { transpose: 12 } }
+`);
+    expect(map.notes.get('KeyX')).toEqual([9]);
+    expect(map.notes.has('KeyZ')).toBe(false);
+    expect(map.notes.get('KeyC')).toEqual([4]);
+  });
+
+  it('skips a column where a grid row lists null', () => {
+    const map = keymap(`
+name: aligned
+grid: { rows: [[KeyZ, KeyX], [null, KeyS]], column: 1, row: 5 }
+`);
+    expect(map.notes.get('KeyX')).toEqual([1]);
+    expect(map.notes.get('KeyS')).toEqual([6]);
+  });
+
+  it('plays a list of offsets as a chord', () => {
+    const map = keymap('name: chords\nnotes: { KeyF: [0, 4, 7] }\n');
+    expect(map.notes.get('KeyF')).toEqual([0, 4, 7]);
+  });
+
+  it('rejects an unknown position by name', () => {
+    expect(messages('name: bad\nnotes: { KeyAA: 0 }\n').join('\n')).toMatch(/KeyAA is not a position a keymap can bind/);
+    expect(messages('name: bad\ngrid: { rows: [[KeyA, Enter]], column: 1, row: 5 }\n').join('\n')).toMatch(
+      /Enter is not a position/,
+    );
+  });
+
+  it('rejects a position that is both a note and a control', () => {
+    expect(messages('name: bad\nnotes: { KeyA: 0 }\ncontrols: { KeyA: { transpose: 12 } }\n').join('\n')).toMatch(
+      /KeyA is both a note and a control/,
+    );
+  });
+
+  it('keeps Escape reserved', () => {
+    expect(messages('name: bad\nnotes: { KeyA: 0 }\ncontrols: { Escape: panic }\n').join('\n')).toMatch(
+      /Escape is reserved/,
+    );
+  });
+
+  it('rejects a note outside 0 to 127', () => {
+    expect(messages('name: bad\nbase: 120\nnotes: { KeyA: 0, KeyS: 8 }\n').join('\n')).toMatch(
+      /KeyS plays MIDI note 128 at base 120/,
+    );
+    expect(messages('name: bad\nbase: 0\ngrid: { rows: [bottom], column: -1, row: 0 }\n').join('\n')).toMatch(
+      /plays MIDI note -1/,
+    );
+  });
+
+  it('rejects a keymap that plays nothing', () => {
+    expect(messages('name: silent\ncontrols: { KeyZ: panic }\n').join('\n')).toMatch(/at least one note/);
+  });
+
+  it('rejects unknown fields rather than ignoring them', () => {
+    expect(parse('name: typo\nnote: { KeyA: 0 }\n').success).toBe(false);
+    expect(parse('name: typo\nnotes: { KeyA: 0 }\ncontrols: { KeyZ: { transpose: 12, by: 1 } }\n').success).toBe(false);
+  });
+
+  it('defaults a cc action to value 127 in set mode', () => {
+    const map = keymap('name: cc\nnotes: { KeyA: 0 }\ncontrols: { Space: { cc: 64, mode: toggle } }\n');
+    expect(map.controls.get('Space')).toEqual({ cc: 64, value: 127, mode: 'toggle' });
+  });
+});
diff --git a/src/schema/keymap.ts b/src/schema/keymap.ts
new file mode 100644
index 0000000..2d4b1c1
--- /dev/null
+++ b/src/schema/keymap.ts
@@ -0,0 +1,182 @@
+import { z } from 'zod';
+
+// A keymap (keyboard-instrument.md §2.4): what each physical key plays in
+// `field keys`. Positions are W3C KeyboardEvent.code values, named after
+// the key a US keyboard has in that place, so a keymap plays the same
+// under any keyboard layout (§2.3).
+
+export const NAMED_ROWS = {
+  bottom: ['KeyZ', 'KeyX', 'KeyC', 'KeyV', 'KeyB', 'KeyN', 'KeyM', 'Comma', 'Period', 'Slash'],
+  home: ['KeyA', 'KeyS', 'KeyD', 'KeyF', 'KeyG', 'KeyH', 'KeyJ', 'KeyK', 'KeyL', 'Semicolon', 'Quote'],
+  top: ['KeyQ', 'KeyW', 'KeyE', 'KeyR', 'KeyT', 'KeyY', 'KeyU', 'KeyI', 'KeyO', 'KeyP', 'BracketLeft', 'BracketRight'],
+  number: ['Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8', 'Digit9', 'Digit0', 'Minus', 'Equal'],
+} as const;
+
+export type RowName = keyof typeof NAMED_ROWS;
+
+// The keys that type a character, whose position a terminal can only
+// report through the character or its base layout key.
+export const TEXT_POSITIONS: readonly string[] = [
+  'Backquote',
+  ...NAMED_ROWS.number,
+  ...NAMED_ROWS.top,
+  'Backslash',
+  ...NAMED_ROWS.home,
+  'IntlBackslash',
+  ...NAMED_ROWS.bottom,
+];
+
+export const FUNCTIONAL_POSITIONS: readonly string[] = [
+  'Space',
+  'Tab',
+  'ArrowLeft',
+  'ArrowRight',
+  'ArrowUp',
+  'ArrowDown',
+];
+
+export const BINDABLE_POSITIONS: ReadonlySet<string> = new Set([...TEXT_POSITIONS, ...FUNCTIONAL_POSITIONS]);
+
+const midiNote = z.number().int().min(0).max(127);
+const offset = z.number().int();
+
+const ccAction = z
+  .object({
+    cc: z.number().int().min(0).max(127),
+    value: z.number().int().min(0).max(127).default(127),
+    mode: z.enum(['set', 'hold', 'toggle']).default('set'),
+  })
+  .strict();
+
+const action = z.union([
+  z.object({ transpose: z.number().int() }).strict(),
+  z.object({ velocity: z.number().int() }).strict(),
+  z.object({ bend: z.number().min(-1).max(1) }).strict(),
+  ccAction,
+  z.literal('panic'),
+]);
+
+export type KeymapAction = z.infer<typeof action>;
+
+const gridRow = z.union([z.enum(['bottom', 'home', 'top', 'number']), z.array(z.string().nullable()).min(1)]);
+
+const grid = z
+  .object({
+    rows: z.array(gridRow).min(1),
+    column: z.number().int(),
+    row: z.number().int(),
+  })
+  .strict();
+
+export type KeymapGrid = z.infer<typeof grid>;
+
+export const keymapSchema = z
+  .object({
+    name: z.string().min(1),
+    description: z.string().optional(),
+    base: midiNote.default(60),
+    velocity: z.number().int().min(1).max(127).default(100),
+    channel: z.number().int().min(1).max(16).default(1),
+    notes: z.record(z.string(), z.union([offset, z.array(offset).min(1)])).optional(),
+    grid: grid.optional(),
+    controls: z.record(z.string(), action).optional(),
+  })
+  .strict()
+  .superRefine((keymap, ctx) => {
+    const checkPosition = (position: string, path: (string | number)[]): void => {
+      if (position === 'Escape') {
+        ctx.addIssue({ code: 'custom', path, message: 'Escape is reserved: it always quits' });
+      } else if (!BINDABLE_POSITIONS.has(position)) {
+        ctx.addIssue({
+          code: 'custom',
+          path,
+          message: `${position} is not a position a keymap can bind (positions are KeyboardEvent.code values, such as KeyA or Semicolon)`,
+        });
+      }
+    };
+
+    for (const position of Object.keys(keymap.notes ?? {})) checkPosition(position, ['notes', position]);
+    for (const position of Object.keys(keymap.controls ?? {})) checkPosition(position, ['controls', position]);
+
+    const gridPositions = new Set<string>();
+    keymap.grid?.rows.forEach((row, rowIndex) => {
+      if (typeof row === 'string') return;
+      row.forEach((position, column) => {
+        if (position === null) return;
+        const path = ['grid', 'rows', rowIndex, column];
+        checkPosition(position, path);
+        if (gridPositions.has(position)) {
+          ctx.addIssue({ code: 'custom', path, message: `${position} appears twice in the grid` });
+        }
+        gridPositions.add(position);
+      });
+    });
+
+    for (const position of Object.keys(keymap.notes ?? {})) {
+      if (keymap.controls?.[position] !== undefined) {
+        ctx.addIssue({
+          code: 'custom',
+          path: ['controls', position],
+          message: `${position} is both a note and a control; a position is one or the other`,
+        });
+      }
+    }
+
+    const notes = expandNotes(keymap);
+    if (notes.size === 0) {
+      ctx.addIssue({ code: 'custom', message: 'a keymap must play at least one note (give notes or a grid)' });
+    }
+    for (const [position, offsets] of notes) {
+      for (const o of offsets) {
+        const note = keymap.base + o;
+        if (note < 0 || note > 127) {
+          ctx.addIssue({
+            code: 'custom',
+            path: keymap.notes?.[position] !== undefined ? ['notes', position] : ['grid'],
+            message: `${position} plays MIDI note ${note} at base ${keymap.base}, outside 0 to 127`,
+          });
+        }
+      }
+    }
+  });
+
+export type KeymapFile = z.infer<typeof keymapSchema>;
+
+// What a position plays once the grid is laid down, `notes` overrides it,
+// and `controls` takes its positions back from both.
+export function expandNotes(keymap: Pick<KeymapFile, 'grid' | 'notes' | 'controls'>): Map<string, number[]> {
+  const notes = new Map<string, number[]>();
+  keymap.grid?.rows.forEach((row, rowIndex) => {
+    const positions: readonly (string | null)[] = typeof row === 'string' ? NAMED_ROWS[row] : row;
+    positions.forEach((position, column) => {
+      if (position !== null) notes.set(position, [column * keymap.grid!.column + rowIndex * keymap.grid!.row]);
+    });
+  });
+  for (const [position, binding] of Object.entries(keymap.notes ?? {})) {
+    notes.set(position, typeof binding === 'number' ? [binding] : binding);
+  }
+  for (const position of Object.keys(keymap.controls ?? {})) notes.delete(position);
+  return notes;
+}
+
+export interface Keymap {
+  name: string;
+  description?: string;
+  base: number;
+  velocity: number;
+  channel: number;
+  notes: ReadonlyMap<string, readonly number[]>;
+  controls: ReadonlyMap<string, KeymapAction>;
+}
+
+export function toKeymap(file: KeymapFile): Keymap {
+  return {
+    name: file.name,
+    ...(file.description !== undefined ? { description: file.description } : {}),
+    base: file.base,
+    velocity: file.velocity,
+    channel: file.channel,
+    notes: expandNotes(file),
+    controls: new Map(Object.entries(file.controls ?? {})),
+  };
+}
