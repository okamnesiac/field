@@ -0,0 +1,153 @@
+import { KeysHelper, SOURCE_NAME } from '../keys/helper.js';
+import { loadKeymap, resolveKeymapSource, watchKeymap, type KeymapSource } from '../keys/keymap.js';
+import { charactersToPositions, PressedKeys, unplayablePositions, type KeyboardLayout } from '../keys/position.js';
+import { printKeymap } from '../keys/print.js';
+import { KeysSession, type MidiMessage } from '../keys/session.js';
+import { decodeTerminal, ENABLE, isQuit, probeKittyProtocol, RESTORE, type Tty } from '../keys/terminal.js';
+import type { Keymap } from '../schema/keymap.js';
+
+export const UNSUPPORTED_TERMINAL =
+  'field keys needs a terminal that reports key releases through the kitty keyboard protocol: ' +
+  'Ghostty, iTerm2 3.5 or later, kitty, or WezTerm. This terminal did not answer the protocol probe.';
+
+export interface KeysOptions {
+  keymap?: string;
+  print?: boolean;
+}
+
+export async function keysCommand(options: KeysOptions): Promise<void> {
+  const source = resolveKeymapSource(options.keymap);
+  const keymap = loadKeymap(source.path);
+  if (options.print === true) {
+    process.stdout.write(printKeymap(keymap));
+    return;
+  }
+  const { stdin, stdout } = process;
+  if (!stdin.isTTY || !stdout.isTTY) {
+    throw new Error('field keys reads the keyboard, so it needs a terminal on stdin and stdout');
+  }
+  await withKittyKeyboard({ stdin, stdout }, (rest) => play({ stdin, stdout }, source, keymap, rest));
+}
+
+// Raw mode and the protocol flags are the terminal's state, not ours, so
+// every way out gives them back: a return, a throw, and a crash.
+async function withKittyKeyboard(tty: Tty, run: (rest: string) => Promise<void>): Promise<void> {
+  let enabled = false;
+  const restore = (): void => {
+    if (enabled) tty.stdout.write(RESTORE);
+    enabled = false;
+    if (tty.stdin.isRaw) tty.stdin.setRawMode(false);
+    tty.stdin.pause();
+  };
+  process.once('exit', restore);
+  try {
+    tty.stdin.setRawMode(true);
+    tty.stdin.resume();
+    const probe = await probeKittyProtocol(tty);
+    if (!probe.supported) throw new Error(UNSUPPORTED_TERMINAL);
+    tty.stdout.write(ENABLE);
+    enabled = true;
+    await run(probe.rest);
+  } finally {
+    restore();
+    process.removeListener('exit', restore);
+  }
+}
+
+async function play(tty: Tty, source: KeymapSource, initial: Keymap, carried: string): Promise<void> {
+  const session = new KeysSession(initial);
+  let layout: KeyboardLayout | undefined;
+  let layoutPositions: ReadonlyMap<string, string> | undefined;
+  let reloadError: string | undefined;
+
+  const draw = (): void => {
+    // A terminal that reports no size reports 0 columns.
+    const width = Math.max(20, (tty.stdout.columns || 80) - 1);
+    tty.stdout.write(`\r\x1b[K${statusText(session, layout, reloadError).slice(0, width)}`);
+  };
+
+  let stop!: (error?: Error) => void;
+  const stopped = new Promise<Error | undefined>((resolve) => {
+    stop = resolve;
+  });
+
+  // Before the helper starts, because its first keyboard layout report
+  // draws the status line.
+  tty.stdout.write(`Playing ${initial.name} as the MIDI source "${SOURCE_NAME}". Esc or Ctrl-C quits.\n`);
+  if (source.kind === 'file') tty.stdout.write(`Saving ${source.path} reloads it.\n`);
+
+  const helper = await KeysHelper.start(SOURCE_NAME, {
+    onKeyboard: (reported) => {
+      layout = reported;
+      layoutPositions = charactersToPositions(reported);
+      draw();
+    },
+    onExit: (reason) => stop(new Error(`the MIDI helper stopped: ${reason}`)),
+  });
+  const send = (messages: MidiMessage[]): void => messages.forEach((m) => helper.send(m));
+
+  const stopWatching =
+    source.kind === 'file'
+      ? watchKeymap(source.path, (result) => {
+          if ('error' in result) {
+            reloadError = result.error.problems[0];
+          } else {
+            reloadError = undefined;
+            session.setKeymap(result.keymap);
+            session.message ??= `reloaded ${result.keymap.name}`;
+          }
+          draw();
+        })
+      : undefined;
+
+  const pressed = new PressedKeys();
+  let pending = carried;
+  const onData = (chunk: Buffer): void => {
+    const { events, rest } = decodeTerminal(pending + chunk.toString('utf8'));
+    pending = rest;
+    for (const event of events) {
+      if (isQuit(event)) return stop();
+      if (event.kind === 'focus' && !event.focused) {
+        send(session.releaseAll());
+        pressed.clear();
+      }
+      if (event.kind === 'key') {
+        const position = pressed.resolve(event, layoutPositions);
+        if (position !== undefined) send(session.handleKey(position, event.type, event.mods));
+      }
+    }
+    draw();
+  };
+  const onSignal = (): void => stop();
+
+  draw();
+  tty.stdin.on('data', onData);
+  for (const signal of ['SIGTERM', 'SIGHUP', 'SIGINT'] as const) process.on(signal, onSignal);
+
+  const error = await stopped;
+
+  tty.stdin.removeListener('data', onData);
+  for (const signal of ['SIGTERM', 'SIGHUP', 'SIGINT'] as const) process.removeListener(signal, onSignal);
+  stopWatching?.();
+  send(session.quit());
+  await helper.close();
+  tty.stdout.write('\n');
+  if (error !== undefined) throw error;
+}
+
+function statusText(session: KeysSession, layout: KeyboardLayout | undefined, reloadError: string | undefined): string {
+  const transpose = session.transpose > 0 ? `+${session.transpose}` : `${session.transpose}`;
+  const notes = session.soundingNotes();
+  const parts = [
+    SOURCE_NAME,
+    session.keymap.name,
+    `transpose ${transpose}`,
+    `velocity ${session.velocity}`,
+    notes.length > 0 ? notes.join(' ') : '–',
+  ];
+  const unplayable = unplayablePositions(layout, session.keymap);
+  if (unplayable.length > 0) parts.push(`${unplayable.join(', ')} cannot play on ${layout!.name}`);
+  if (reloadError !== undefined) parts.push(`keymap not reloaded: ${reloadError}`);
+  if (session.message !== undefined) parts.push(session.message);
+  return parts.join(' · ');
+}
diff --git a/src/keys/helper-native.test.ts b/src/keys/helper-native.test.ts
new file mode 100644
index 0000000..538fa56
--- /dev/null
+++ b/src/keys/helper-native.test.ts
@@ -0,0 +1,221 @@
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process';
+import { existsSync } from 'node:fs';
+import { createInterface } from 'node:readline';
+import { afterEach, describe, expect, it, type TestContext } from 'vitest';
+import { daemonBinary } from '../audiod/client.js';
+
+// The native round trip (keyboard-instrument.md §4): `field-audiod --keys`
+// publishes a virtual MIDI source and `--midi-monitor` reads it back. The
+// probe for a MIDI service is `--keys` itself, and the only error allowed
+// to skip is a Linux machine without the ALSA sequencer, so a green run
+// without a MIDI service never reads as coverage.
+
+const binary = (() => {
+  try {
+    return daemonBinary();
+  } catch {
+    return undefined;
+  }
+})();
+
+const BINDABLE_POSITIONS = [
+  'Backquote',
+  'Digit1',
+  'Digit2',
+  'Digit3',
+  'Digit4',
+  'Digit5',
+  'Digit6',
+  'Digit7',
+  'Digit8',
+  'Digit9',
+  'Digit0',
+  'Minus',
+  'Equal',
+  'KeyQ',
+  'KeyW',
+  'KeyE',
+  'KeyR',
+  'KeyT',
+  'KeyY',
+  'KeyU',
+  'KeyI',
+  'KeyO',
+  'KeyP',
+  'BracketLeft',
+  'BracketRight',
+  'Backslash',
+  'KeyA',
+  'KeyS',
+  'KeyD',
+  'KeyF',
+  'KeyG',
+  'KeyH',
+  'KeyJ',
+  'KeyK',
+  'KeyL',
+  'Semicolon',
+  'Quote',
+  'KeyZ',
+  'KeyX',
+  'KeyC',
+  'KeyV',
+  'KeyB',
+  'KeyN',
+  'KeyM',
+  'Comma',
+  'Period',
+  'Slash',
+  'IntlBackslash',
+];
+
+const LINE_TIMEOUT_MS = 5000;
+
+type Line = Record<string, unknown>;
+
+interface Helper {
+  args: string[];
+  child: ChildProcessWithoutNullStreams;
+  stdout: string[];
+  stderr: string;
+  ended: boolean;
+  closed: Promise<number | null>;
+}
+
+const running: Helper[] = [];
+
+function spawnHelper(...args: string[]): Helper {
+  const child = spawn(binary!, args, { stdio: 'pipe' });
+  const helper: Helper = {
+    args,
+    child,
+    stdout: [],
+    stderr: '',
+    ended: false,
+    closed: new Promise((resolve) => {
+      child.on('close', (code) => {
+        helper.ended = true;
+        resolve(code);
+      });
+    }),
+  };
+  child.on('error', (error) => {
+    helper.stderr += String(error);
+  });
+  // A write to a helper that has already exited shows up in its exit
+  // code and output; without a listener the EPIPE would kill the worker.
+  child.stdin.on('error', () => {});
+  child.stderr.on('data', (chunk) => {
+    helper.stderr += String(chunk);
+  });
+  createInterface({ input: child.stdout }).on('line', (line) => helper.stdout.push(line));
+  running.push(helper);
+  return helper;
+}
+
+function parse(helper: Helper, index: number): Line {
+  const raw = helper.stdout[index]!;
+  try {
+    return JSON.parse(raw) as Line;
+  } catch {
+    throw new Error(`${helper.args.join(' ')}: stdout line ${index + 1} is not JSON: ${raw}`);
+  }
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+async function lineAt(helper: Helper, index: number): Promise<Line> {
+  const deadline = Date.now() + LINE_TIMEOUT_MS;
+  while (helper.stdout.length <= index) {
+    const said = `${helper.args.join(' ')} printed ${helper.stdout.length} lines; stderr: ${helper.stderr}`;
+    if (helper.ended) throw new Error(`exited before stdout line ${index + 1}: ${said}`);
+    if (Date.now() > deadline) throw new Error(`timed out waiting for stdout line ${index + 1}: ${said}`);
+    await sleep(10);
+  }
+  return parse(helper, index);
+}
+
+function linesFrom(helper: Helper, index: number): Line[] {
+  return helper.stdout.slice(index).map((_, offset) => parse(helper, index + offset));
+}
+
+function withoutLayoutReports(lines: Line[]): Line[] {
+  return lines.filter((line) => !('keyboard' in line));
+}
+
+function expectFullLayoutReport(line: Line): void {
+  expect(Object.keys(line)).toEqual(['keyboard']);
+  const report = line['keyboard'] as { name: unknown; keys: Record<string, unknown>; dead: string[] };
+  expect(typeof report.name).toBe('string');
+  expect(report.name).not.toBe('');
+  for (const typed of Object.values(report.keys)) expect(typeof typed).toBe('string');
+  expect([...Object.keys(report.keys), ...report.dead].sort()).toEqual([...BINDABLE_POSITIONS].sort());
+}
+
+// Starts `--keys <name>` and returns it with the index of the first line
+// after `ready`. On macOS the layout report must come first.
+async function startKeys(ctx: TestContext, name: string): Promise<{ keys: Helper; afterReady: number }> {
+  const keys = spawnHelper('--keys', name);
+  let index = 0;
+  if (process.platform === 'darwin') expectFullLayoutReport(await lineAt(keys, index++));
+
+  const published = await lineAt(keys, index++);
+  if ('error' in published && process.platform === 'linux' && !existsSync('/dev/snd/seq')) {
+    const reason =
+      `no MIDI service: this Linux machine has no ALSA sequencer at /dev/snd/seq, ` +
+      `and --keys said ${JSON.stringify(published['error'])}`;
+    console.warn(`skipping the native MIDI round trip: ${reason}`);
+    ctx.skip(reason);
+  }
+  expect(published).toEqual({ ready: true, name });
+  return { keys, afterReady: index };
+}
+
+describe.skipIf(!binary)('field-audiod --keys and --midi-monitor (native round trip)', () => {
+  const base = `Field Keys Test ${process.pid}`;
+
+  afterEach(async () => {
+    const left = running.splice(0);
+    for (const helper of left) if (!helper.ended) helper.child.kill('SIGKILL');
+    await Promise.all(left.map((helper) => helper.closed));
+  });
+
+  it(
+    'delivers each message to a monitor in order, and exits 0 at the end of its input',
+    { timeout: 20_000 },
+    async (ctx) => {
+      const { keys, afterReady } = await startKeys(ctx, base);
+      const monitor = spawnHelper('--midi-monitor', base);
+      expect(await lineAt(monitor, 0)).toEqual({ ready: true, name: base });
+
+      keys.child.stdin.write('{"midi":[144,60,100]}\n\n  \n{"midi":[128,60,0]}\n');
+      expect(await lineAt(monitor, 1)).toEqual({ midi: [144, 60, 100] });
+      expect(await lineAt(monitor, 2)).toEqual({ midi: [128, 60, 0] });
+
+      keys.child.stdin.end();
+      expect(await keys.closed).toBe(0);
+      expect(withoutLayoutReports(linesFrom(keys, afterReady))).toEqual([]);
+
+      monitor.child.kill('SIGTERM');
+      expect(await monitor.closed).toBe(0);
+      expect(linesFrom(monitor, 3)).toEqual([]);
+    },
+  );
+
+  it.for([
+    ['not JSON', 'note on 60'],
+    ['a JSON array', '[144,60,100]'],
+    ['no bytes', '{"midi":[]}'],
+    ['four bytes', '{"midi":[144,60,100,0]}'],
+    ['no status byte', '{"midi":[60,100]}'],
+    ['a byte above 255', '{"midi":[144,60,256]}'],
+    ['a property besides midi', '{"midi":[144,60,100],"at":0}'],
+  ] as const)('answers a line with %s with an error and exit 1', { timeout: 20_000 }, async ([what, line], ctx) => {
+    const { keys, afterReady } = await startKeys(ctx, `${base} ${what}`);
+    keys.child.stdin.write(`${line}\n`);
+    expect(await keys.closed).toBe(1);
+    expect(withoutLayoutReports(linesFrom(keys, afterReady))).toEqual([{ error: expect.any(String) }]);
+  });
+});
