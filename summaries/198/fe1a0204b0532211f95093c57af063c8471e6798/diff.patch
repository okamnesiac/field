+        in -= range;
+        if (in < hi)
+            return in;
+    } else if (in < lo) {
+        range = hi - lo;
+        in += range;
+        if (in >= lo)
+            return in;
+    } else
+        return in;
+
+    if (hi == lo)
+        return lo;
+    return in - range * sc_floor((in - lo) / range);
+}
