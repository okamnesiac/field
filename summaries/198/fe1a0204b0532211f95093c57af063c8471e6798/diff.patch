+    return x;
+}
+
+/// Answer -1 if negative, +1 if positive or 0 if zero
+inline float64 sc_sign(float64 x) { return x < 0. ? -1. : (x > 0. ? 1. : 0.); }
+
+/// A nonlinear distortion function.
+inline float64 sc_distort(float64 x) { return x / (1. + std::abs(x)); }
