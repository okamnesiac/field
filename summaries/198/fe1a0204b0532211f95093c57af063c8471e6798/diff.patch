+        if (held > 2 * target)
+        {
+            const uint64_t drop = held - target;
+            at += drop;
+            held = target;
+            skipped.fetch_add (drop, std::memory_order_relaxed);
+        }
+        taken = (int) std::min<uint64_t> (held, (uint64_t) n);
+        const float* data = ring::data (header);
+        const uint64_t mask = frames - 1;
+        for (int i = 0; i < taken; ++i)
+        {
+            const size_t from = (size_t) ((at + (uint64_t) i) & mask) * ring::channels;
+            left[i] = data[from];
+            right[i] = data[from + 1];
+        }
+        at += (uint64_t) taken;
+        if (taken < n)
+        {
+            underruns.fetch_add (1, std::memory_order_relaxed);
+            primed = false;
+        }
+    }
+    // Stored even while priming, so the writer sees what was skipped.
+    header->read.store (at, std::memory_order_release);
+#endif
+    std::fill (left + taken, left + n, 0.0f);
+    std::fill (right + taken, right + n, 0.0f);
+}
+
+juce::var RingInput::stats() const
+{
+    auto* object = new juce::DynamicObject();
+    object->setProperty ("ring", (int) ringId);
+#if ! defined(_WIN32)
+    const auto* header = static_cast<const ring::Header*> (mapped);
+    object->setProperty ("written", (juce::int64) header->written.load (std::memory_order_relaxed));
+    object->setProperty ("read", (juce::int64) header->read.load (std::memory_order_relaxed));
+    object->setProperty ("dropped", (juce::int64) header->dropped.load (std::memory_order_relaxed));
+#endif
+    object->setProperty ("underruns", (juce::int64) underruns.load (std::memory_order_relaxed));
+    object->setProperty ("skipped", (juce::int64) skipped.load (std::memory_order_relaxed));
+    return juce::var (object);
+}
+
+std::string runRingSelfTest()
+{
+#if defined(_WIN32)
+    return "the ring needs POSIX shared memory";
+#else
+    struct Writer
+    {
+        explicit Writer (uint32_t id)
+        {
+            const char* error = nullptr;
+            mapping = ring::open (id, error);
+            if (mapping.header == nullptr)
+                throw std::runtime_error (std::string ("the writer could not open the ring: ") + error);
+        }
+        ~Writer() { ring::unmap (mapping); }
+        // A burst of the frames that come next: left counts up from 0 and
+        // right is its negation, so a reader can tell any gap or repeat.
+        void burst (int n)
+        {
+            float left[512], right[512];
+            for (int i = 0; i < n; ++i)
+            {
+                left[i] = (float) (next + (uint64_t) i);
+                right[i] = -left[i];
+            }
+            ring::write (mapping.header, left, right, n);
+            next += (uint64_t) n;
+        }
+        ring::Mapping mapping;
+        uint64_t next = 0;
+    };
+    // The reader's left channel, call after call, and whether every value
+    // that is not silence follows the one before it, allowing a jump
+    // forward only where `skipsAllowed`.
+    struct Reader
+    {
+        explicit Reader (RingInput& input) : input (input) {}
+        void block() { take (512, 0); }
+        // One 512-frame block read in two calls, as a session reads one
+        // it splits.
+        void split (int first) { take (first, 512 - first); }
+        void take (int first, int second)
+        {
+            float left[512], right[512];
+            input.read (left, right, first);
+            if (second > 0)
+                input.read (left + first, right + first, second);
+            for (int i = 0; i < first + second; ++i)
+            {
+                if (right[i] != -left[i])
+                    mirrored = false;
+                if (left[i] == 0.0f && right[i] == 0.0f && ! started)
+                    continue;
+                if (left[i] == 0.0f && started)
+                {
+                    ++silent;
+                    continue;
+                }
+                if (started && left[i] != last + 1.0f)
+                {
+                    if (left[i] < last)
+                        backwards = true;
+                    if (jumps++ == 0)
+                        firstAfterJump = left[i];
+                }
+                started = true;
+                last = left[i];
+                ++heard;
+            }
+        }
+        RingInput& input;
+        bool started = false, mirrored = true, backwards = false;
+        float last = -1.0f, firstAfterJump = -1.0f;
+        uint64_t heard = 0, silent = 0, jumps = 0;
+    };
+    const auto check = [] (bool holds, const std::string& what) -> std::string { return holds ? "" : what; };
+
+    try
+    {
+        {
+            // Steady: four 128-frame bursts a 512-frame block. After it
+            // primes, every frame plays once, in order.
+            RingInput input (48000);
+            Writer writer (input.id());
+            Reader reader (input);
+            for (int cycle = 0; cycle < 200; ++cycle)
+            {
+                for (int b = 0; b < 4; ++b)
+                    writer.burst (128);
+                reader.block();
+            }
+            if (auto e = check (reader.jumps == 0 && reader.silent == 0 && reader.mirrored && reader.heard > 0,
+                                "steady: the reader skipped, repeated, or fell silent");
+                ! e.empty())
+                return e;
+        }
+        {
+            // A writer that stops for three blocks: the reader plays what
+            // it holds, runs dry once, waits to fill, and goes on from the
+            // frame after the last it played.
+            RingInput input (48000);
+            Writer writer (input.id());
+            Reader reader (input);
+            for (int cycle = 0; cycle < 60; ++cycle)
+            {
+                if (cycle < 20 || cycle >= 23)
+                    for (int b = 0; b < 4; ++b)
+                        writer.burst (128);
+                reader.block();
+            }
+            const auto stats = input.stats();
+            if (auto e = check ((juce::int64) stats["underruns"] == 1 && reader.jumps == 0 && reader.silent > 0
+                                    && ! reader.backwards,
+                                "underrun: the reader lost or repeated frames across the gap");
+                ! e.empty())
+                return e;
+        }
+        {
+            // A writer a burst fast every block: the ring creeps up, the
+            // reader drops the oldest excess, and never runs dry.
+            RingInput input (48000);
+            Writer writer (input.id());
+            Reader reader (input);
+            for (int cycle = 0; cycle < 200; ++cycle)
+            {
+                for (int b = 0; b < 5; ++b)
+                    writer.burst (128);
+                reader.block();
+            }
+            const auto stats = input.stats();
+            if (auto e = check ((juce::int64) stats["skipped"] > 0 && (juce::int64) stats["underruns"] == 0
+                                    && reader.silent == 0 && ! reader.backwards,
+                                "drift: the reader did not hold the ring level");
+                ! e.empty())
+                return e;
+        }
+        {
+            // A block split the way a session splits one at a loop wrap,
+            // 300 frames and then 212, reads against the whole block's
+            // margin: nothing skipped, nothing run dry.
+            RingInput input (48000);
+            Writer writer (input.id());
+            Reader reader (input);
+            for (int cycle = 0; cycle < 200; ++cycle)
+            {
+                for (int b = 0; b < 4; ++b)
+                    writer.burst (128);
+                if (cycle % 2 == 0)
+                    reader.block();
+                else
+                    reader.split (300);
+            }
+            const auto stats = input.stats();
+            if (auto e = check ((juce::int64) stats["skipped"] == 0 && (juce::int64) stats["underruns"] == 0
+                                    && reader.jumps == 0 && reader.silent == 0,
+                                "split: a split block shrank the margin");
+                ! e.empty())
+                return e;
+        }
+        {
+            // A gap longer than the ring: the writer drops its newest
+            // frames, and the reader skips everything it held to start at
+            // the present rather than play the past.
+            RingInput input (48000);
+            Writer writer (input.id());
+            Reader reader (input);
+            for (int cycle = 0; cycle < 20; ++cycle)
+            {
+                for (int b = 0; b < 4; ++b)
+                    writer.burst (128);
+                reader.block();
+            }
+            const float before = reader.last;
+            for (int b = 0; b < 80; ++b)
+                writer.burst (128);
+            const uint64_t present = writer.next;
+            for (int cycle = 0; cycle < 20; ++cycle)
+            {
+                for (int b = 0; b < 4; ++b)
+                    writer.burst (128);
+                reader.block();
+            }
+            if (auto e = check (reader.jumps == 1 && ! reader.backwards && reader.last > before
+                                    && (uint64_t) reader.firstAfterJump >= present,
+                                "gap: the reader played frames from before it stopped reading");
+                ! e.empty())
+                return e;
+        }
+        {
+            // Nothing reading: the ring fills and the rest counts as
+            // dropped, not overwritten.
+            RingInput input (48000);
+            Writer writer (input.id());
+            for (int b = 0; b < 80; ++b)
+                writer.burst (128);
+            const auto stats = input.stats();
+            if (auto e = check ((juce::int64) stats["written"] == 8192 && (juce::int64) stats["dropped"] == 80 * 128 - 8192,
+                                "overflow: the writer overwrote or lost count");
+                ! e.empty())
+                return e;
+        }
+    }
+    catch (const std::exception& e)
+    {
+        return e.what();
+    }
+    return {};
+#endif
+}
+
+} // namespace field
diff --git a/native/audiod/src/ring_input.h b/native/audiod/src/ring_input.h
new file mode 100644
index 00000000..111f8de7
--- /dev/null
+++ b/native/audiod/src/ring_input.h
@@ -0,0 +1,75 @@
+#pragma once
+
+#include <juce_core/juce_core.h>
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include "live.h"
+
+namespace field
+{
+
+// A ring the daemon owns and reads (live-supercollider.md §2): made by
+// the `input` op, written by FieldOut in the voice host's scsynth
+// (native/ring/field_ring.h), and read once per block by the session
+// input window of the same name.
+class RingInput final : public LiveInput
+{
+public:
+    // Makes the shared-memory ring at a number nothing else holds. Throws
+    // when the system refuses, and on Windows, which has no POSIX shared
+    // memory.
+    explicit RingInput (uint32_t sampleRate, uint32_t capacity = 8192);
+    ~RingInput() override;
+    RingInput (const RingInput&) = delete;
+    RingInput& operator= (const RingInput&) = delete;
+
+    uint32_t id() const { return ringId; }
+    uint32_t capacity() const { return frames; }
+
+    // Unlinks the name, so a later ring may take the number; a session
+    // still holding this one keeps reading what it maps until it lets go.
+    void retire();
+
+    // The jitter buffer: it waits until it holds a block plus one writer
+    // burst before it plays, the block being the largest any call has
+    // asked for, so a block the session splits at a loop wrap reads
+    // against the same margin as a whole one. When the writer runs fast
+    // enough to hold twice that, the oldest frames go; when it runs dry,
+    // the reader plays what it has, then waits to fill again. When the
+    // writer dropped frames because nothing read for longer than the ring
+    // holds, what is held is stale, and the reader starts at the present.
+    void read (float* left, float* right, int n) override;
+
+    // For `status`: frames written, read, and dropped by the writer, how
+    // often the reader ran dry, and the frames it skipped for drift.
+    juce::var stats() const;
+
+    // What the reader keeps in hand beyond its block: one burst of the
+    // writer's, which the voice host runs at a 128-frame hardware buffer,
+    // doubled for scheduling slack.
+    static constexpr uint64_t writerBurst = 256;
+
+private:
+    uint32_t ringId = 0;
+    uint32_t frames = 0;
+    void* mapped = nullptr;
+    size_t bytes = 0;
+    bool linked = false;
+    uint64_t at = 0; // frames read, the reader's own copy of the header's
+    uint64_t block = 0; // the largest call so far
+    uint64_t droppedSeen = 0; // the writer's dropped count at the last read
+    bool primed = false;
+    std::atomic<uint64_t> underruns { 0 };
+    std::atomic<uint64_t> skipped { 0 };
+};
+
+// --ring-selftest: a RingInput and a writer through field_ring.h, the
+// code FieldOut runs, interleaved the way two callbacks are, in steady
+// state, through a writer that stops, one that runs fast, and one with
+// nothing reading. Empty string when every scenario holds.
+std::string runRingSelfTest();
+
+} // namespace field
